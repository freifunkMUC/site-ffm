+++++ b/drivers/net/ethernet/stmicro/stmmac/enh_desc.c
++@@ -200,9 +200,6 @@ static int enh_desc_get_rx_status(struct stmmac_extra_stats *x,
++ 		if (unlikely(rdes0 & RDES0_OVERFLOW_ERROR))
++ 			x->rx_gmac_overflow++;
