++ 	batadv_gw_node_put(curr_gw);
++ }
++ 
+++/**
+++ * batadv_gw_node_is_stale() - check if the OGMs of a gateway stopped
+++ * @bat_priv: the bat priv with all the soft interface information
+++ * @gw_node: the gateway node to check
+++ *
+++ * The metric towards a gateway does not change without OGMs, and the router
+++ * towards it stays until the neighbor purge (BATADV_PURGE_TIMEOUT). Without
+++ * this check, a gateway that lost power stays selected for this time.
+++ *
+++ * Return: true if no OGM of the gateway arrived for
+++ *  BATADV_GW_STALE_INTERVALS originator intervals (at least
+++ *  BATADV_GW_STALE_TIMEOUT_MIN ms), false otherwise
+++ */
+++bool batadv_gw_node_is_stale(struct batadv_priv *bat_priv,
+++			     struct batadv_gw_node *gw_node)
+++{
+++	u32 timeout = atomic_read(&bat_priv->orig_interval);
+++
+++	timeout = min_t(u32, timeout, U32_MAX / BATADV_GW_STALE_INTERVALS);
+++	timeout *= BATADV_GW_STALE_INTERVALS;
+++	timeout = max_t(u32, timeout, BATADV_GW_STALE_TIMEOUT_MIN);
+++
+++	return batadv_has_timed_out(READ_ONCE(gw_node->orig_node->last_seen),
+++				    timeout);
+++}
+++
++ /**
++  * batadv_gw_election() - Elect the best gateway
++  * @bat_priv: the bat priv with all the soft interface information
++@@ -202,6 +231,7 @@ void batadv_gw_election(struct batadv_priv *bat_priv)
++ 	struct batadv_neigh_node *router = NULL;
++ 	struct batadv_neigh_ifinfo *router_ifinfo = NULL;
++ 	char gw_addr[18] = { '\0' };
+++	bool curr_stale;
++ 
++ 	if (atomic_read(&bat_priv->gw.mode) != BATADV_GW_MODE_CLIENT)
++ 		goto out;
++@@ -211,7 +241,10 @@ void batadv_gw_election(struct batadv_priv *bat_priv)
++ 
++ 	curr_gw = batadv_gw_get_selected_gw_node(bat_priv);
++ 
++-	if (!batadv_atomic_dec_not_zero(&bat_priv->gw.reselect) && curr_gw)
+++	curr_stale = curr_gw && batadv_gw_node_is_stale(bat_priv, curr_gw);
+++
+++	if (!batadv_atomic_dec_not_zero(&bat_priv->gw.reselect) && curr_gw &&
+++	    !curr_stale)
++ 		goto out;
++ 
++ 	/* if gw.reselect is set to 1 it means that a previous call to
++@@ -223,6 +256,10 @@ void batadv_gw_election(struct batadv_priv *bat_priv)
++ 	if (curr_gw == next_gw)
++ 		goto out;
++ 
+++	/* keep a stale gateway until a gateway with OGMs is known */
+++	if (curr_stale && !next_gw)
+++		goto out;
+++
++ 	if (next_gw) {
++ 		sprintf(gw_addr, "%pM", next_gw->orig_node->orig);
++ 
++diff --git a/net/batman-adv/gateway_client.h b/net/batman-adv/gateway_client.h
++index 95c2ccd..53054d9 100644
++--- a/net/batman-adv/gateway_client.h
+++++ b/net/batman-adv/gateway_client.h
++@@ -18,6 +18,8 @@
++ void batadv_gw_check_client_stop(struct batadv_priv *bat_priv);
++ void batadv_gw_reselect(struct batadv_priv *bat_priv);
++ void batadv_gw_election(struct batadv_priv *bat_priv);
+++bool batadv_gw_node_is_stale(struct batadv_priv *bat_priv,
+++			     struct batadv_gw_node *gw_node);
++ struct batadv_orig_node *
++ batadv_gw_get_selected_orig(struct batadv_priv *bat_priv);
++ void batadv_gw_check_election(struct batadv_priv *bat_priv,
++diff --git a/net/batman-adv/main.h b/net/batman-adv/main.h
++index 97ea71a..ff42169 100644
++--- a/net/batman-adv/main.h
+++++ b/net/batman-adv/main.h
++@@ -32,6 +32,9 @@
++  * -> TODO: check influence on BATADV_TQ_LOCAL_WINDOW_SIZE
++  */
++ #define BATADV_PURGE_TIMEOUT 200000 /* 200 seconds */
+++/* a gateway without an OGM for this many originator intervals is stale */
+++#define BATADV_GW_STALE_INTERVALS 3
+++#define BATADV_GW_STALE_TIMEOUT_MIN 5000 /* 5 seconds */
++ #define BATADV_TT_LOCAL_TIMEOUT 600000 /* in milliseconds */
++ #define BATADV_TT_CLIENT_ROAM_TIMEOUT 600000 /* in milliseconds */
++ #define BATADV_TT_CLIENT_TEMP_TIMEOUT 600000 /* in milliseconds */
