+diff --git a/target/linux/generic/pending-5.15/861-powerpc-fix-eBPF-JIT-compilation.patch b/target/linux/generic/pending-5.15/861-powerpc-fix-eBPF-JIT-compilation.patch
+new file mode 100644
+index 0000000000..e647afb88d
+--- /dev/null
++++ b/target/linux/generic/pending-5.15/861-powerpc-fix-eBPF-JIT-compilation.patch
+@@ -0,0 +1,60 @@
++From ff2054af82150ac9b96e3cb7a73bbaebb1b6baee Mon Sep 17 00:00:00 2001
++From: Grische <2787581+grische@users.noreply.github.com>
++Date: Tue, 3 Feb 2026 22:03:56 +0100
++Subject: [PATCH] powerpc: fix eBPF JIT compilation
++
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 22 ++++++++++++++++++++--
++ 1 file changed, 20 insertions(+), 2 deletions(-)
++
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index bce5eda85170..2d02810b80fc 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -168,7 +168,10 @@ static void bpf_jit_emit_common_epilogue(u32 *image, struct codegen_context *ctx
++ 
++ void bpf_jit_build_epilogue(u32 *image, struct codegen_context *ctx)
++ {
+++	/* Store in reverse order (lower bits in R3 instead of R4) since the
+++	 * kernel expects bpf functions to return 32 bit values in R3. */
++ 	EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(ctx, BPF_REG_0)));
+++	EMIT(PPC_RAW_MR(_R4, bpf_to_ppc(ctx, BPF_REG_0) - 1));
++ 
++ 	bpf_jit_emit_common_epilogue(image, ctx);
++ 
++@@ -876,6 +879,13 @@ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *
++ 			if (ret < 0)
++ 				return ret;
++ 
+++			/* bpf function prologues expect the first arg to be a 32bit
+++			 * pointer in R3, but kernel functions expect it to be 64bit
+++			 * with the non-zero bits in R4, which matches BPF_REG_1.
+++			 */
+++			if (insn[i].src_reg == BPF_PSEUDO_CALL)
+++				EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_1)));
+++
++ 			if (bpf_is_seen_register(ctx, bpf_to_ppc(ctx, BPF_REG_5))) {
++ 				EMIT(PPC_RAW_STW(bpf_to_ppc(ctx, BPF_REG_5) - 1, _R1, 8));
++ 				EMIT(PPC_RAW_STW(bpf_to_ppc(ctx, BPF_REG_5), _R1, 12));
++@@ -883,8 +893,16 @@ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *
++ 
++ 			bpf_jit_emit_func_call_rel(image, ctx, func_addr);
++ 
++-			EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0) - 1, _R3));
++-			EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0), _R4));
+++			/* bpf function epilogues return values in reverse order to match
+++			 * the expectation of the kernel caller, so reverse again here.
+++			 */
+++			if (insn[i].src_reg == BPF_PSEUDO_CALL) {
+++				EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0), _R3));
+++				EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0) - 1, _R4));
+++			} else {
+++				EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0) - 1, _R3));
+++				EMIT(PPC_RAW_MR(bpf_to_ppc(ctx, BPF_REG_0), _R4));
+++			}
++ 			break;
++ 
++ 		/*
++-- 
++2.43.0
