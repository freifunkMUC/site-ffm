From: David Bauer <mail@david-bauer.net>
Date: Mon, 11 Dec 2023 18:12:17 +0100
Subject: [PATCH 4/5] ci: check build-output image size

---
 .github/workflows/build-gluon.yml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/.github/workflows/build-gluon.yml b/.github/workflows/build-gluon.yml
index 6081f8fd..8f3cc236 100644
--- a/.github/workflows/build-gluon.yml
+++ b/.github/workflows/build-gluon.yml
@@ -50,6 +50,9 @@ jobs:
       - name: Build Gluon
         run: docker run --rm -v $PWD:/gluon-ci -w /gluon-ci --user "$(id -u):$(id -g)" gluon-ci-container contrib/actions/run-build.sh ${{ matrix.target }}
 
+      - name: Check Image size
+        run: contrib/check-image-size.py --github-actions --overhead 256 output/meta/openwrt-profiles/${{ matrix.target }}.json
+
       - name: Archive build logs
         if: ${{ !cancelled() }}
         uses: actions/upload-artifact@v3
