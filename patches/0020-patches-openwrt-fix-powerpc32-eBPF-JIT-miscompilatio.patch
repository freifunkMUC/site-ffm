+diff --git a/target/linux/generic/pending-6.6/343-powerpc32-bpf-fix-argument-passing-for-subprograms.patch b/target/linux/generic/pending-6.6/343-powerpc32-bpf-fix-argument-passing-for-subprograms.patch
+new file mode 100644
+index 0000000000..54160d1be1
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/343-powerpc32-bpf-fix-argument-passing-for-subprograms.patch
+@@ -0,0 +1,96 @@
++From f7abfa8c8b0ddfc44b52091a080df5998b1138f8 Mon Sep 17 00:00:00 2001
++From: Lukas Stockner <lukas@lukasstockner.de>
++Date: Fri, 20 Nov 2026 15:21:53 +0100
++Subject: [PATCH 343/348] powerpc32/bpf: fix argument passing for subprograms
++
++The PPC32 JIT assumes that functions follow the main program calling convention
++
++unsigned int (*bpf_func_t)(const void *)
++
++while the generated calling sequence matches the calling convention for helpers
++
++u64 (*bpf_callback_t)(u64, u64, u64, u64, u64)
++
++This is fine for regular programs, but for BPF-to-BPF calls, the caller will be
++passing the first argument as a 64-bit value while the callee expects it to be
++32-bit. The same applies to the return value.
++In particular, in the common case where the first argument is a context pointer,
++the callee ends up using its upper (zeroed) 32 bits, which then triggers a
++kernel panic as soon as it's used.
++
++Therefore, make the JIT emit the appropriate 64-bit prologue/epilogue for
++subprograms.
++
++Fixes: 51c66ad849a7 ("powerpc/bpf: Implement extended BPF on PPC32")
++Signed-off-by: Lukas Stockner <lukas@lukasstockner.de>
++
++[ Backport to 6.6: there is no ctx->is_subprog yet. Add it to struct
++  codegen_context and set it from fp->aux->func_idx in
++  bpf_int_jit_compile(). ]
++---
++ arch/powerpc/net/bpf_jit.h        |  1 +
++ arch/powerpc/net/bpf_jit_comp.c   |  1 +
++ arch/powerpc/net/bpf_jit_comp32.c | 16 ++++++++++++----
++ 3 files changed, 14 insertions(+), 4 deletions(-)
++
++diff --git a/arch/powerpc/net/bpf_jit.h b/arch/powerpc/net/bpf_jit.h
++index 72b7bb34fade..8bf11b659fd9 100644
++--- a/arch/powerpc/net/bpf_jit.h
+++++ b/arch/powerpc/net/bpf_jit.h
++@@ -137,6 +137,7 @@ struct codegen_context {
++ 	int b2p[MAX_BPF_JIT_REG + 2];
++ 	unsigned int exentry_idx;
++ 	unsigned int alt_exit_addr;
+++	bool is_subprog;
++ };
++ 
++ #define bpf_to_ppc(r)	(ctx->b2p[r])
++diff --git a/arch/powerpc/net/bpf_jit_comp.c b/arch/powerpc/net/bpf_jit_comp.c
++index 37043dfc1add..aca014eb51cf 100644
++--- a/arch/powerpc/net/bpf_jit_comp.c
+++++ b/arch/powerpc/net/bpf_jit_comp.c
++@@ -117,6 +117,7 @@ struct bpf_prog *bpf_int_jit_compile(struct bpf_prog *fp)
++ 
++ 	/* Make sure that the stack is quadword aligned. */
++ 	cgctx.stack_size = round_up(fp->aux->stack_depth, 16);
+++	cgctx.is_subprog = fp->aux->func_idx != 0;
++ 
++ 	/* Scouting faux-generate pass 0 */
++ 	if (bpf_jit_build_body(fp, 0, &cgctx, addrs, 0, false)) {
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index 06f886850a93..f4f76ae61df9 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -141,9 +141,11 @@ void bpf_jit_build_prologue(u32 *image, struct codegen_context *ctx)
++ 	if (ctx->seen & SEEN_TAILCALL)
++ 		EMIT(PPC_RAW_STW(_R4, _R1, bpf_jit_stack_offsetof(ctx, BPF_PPC_TC)));
++ 
++-	/* First arg comes in as a 32 bits pointer. */
++-	EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_1), _R3));
++-	EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_1) - 1, 0));
+++	/* Programs receive the first arg as a 32 bits pointer, subprograms don't. */
+++	if (!ctx->is_subprog) {
+++		EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_1), _R3));
+++		EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_1) - 1, 0));
+++	}
++ 
++ 	/*
++ 	 * We need a stack frame, but we don't necessarily need to
++@@ -193,7 +195,13 @@ static void bpf_jit_emit_common_epilogue(u32 *image, struct codegen_context *ctx
++ 
++ void bpf_jit_build_epilogue(u32 *image, struct codegen_context *ctx)
++ {
++-	EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0)));
+++	/* Programs return a 32-bit value, while subprograms return 64 bit. */
+++	if (ctx->is_subprog) {
+++		EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0) - 1));
+++		EMIT(PPC_RAW_MR(_R4, bpf_to_ppc(BPF_REG_0)));
+++	} else {
+++		EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0)));
+++	}
++ 
++ 	bpf_jit_emit_common_epilogue(image, ctx);
++ 
++-- 
++2.54.0
++
+diff --git a/target/linux/generic/pending-6.6/344-powerpc32-bpf-don-t-fold-consecutive-MOVs.patch b/target/linux/generic/pending-6.6/344-powerpc32-bpf-don-t-fold-consecutive-MOVs.patch
+new file mode 100644
+index 0000000000..94c71f57f8
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/344-powerpc32-bpf-don-t-fold-consecutive-MOVs.patch
+@@ -0,0 +1,37 @@
++From 48da5992f5c671e16429cc9e646e97269a73500b Mon Sep 17 00:00:00 2001
++From: Lukas Stockner <lukas@lukasstockner.de>
++Date: Sat, 21 Nov 2026 14:17:40 +0100
++Subject: [PATCH 344/348] powerpc32/bpf: don't fold consecutive MOVs
++
++The PPC32 eBPF JIT folds MOVs followed by an ALU operation to the same
++destination into a 3-operand PPC operation, by dropping the MOV and reusing
++its source as the second operand for the second instruction.
++
++However, for the special case of a MOV followed by zero-extension (which also
++is a MOV, and thus counts as an ALU operation), the code that emits the latter
++ignores the second source operand, so the lower half never gets assigned.
++
++That could be fixed, but there are other corner cases around consecutive MOV,
++so it's safer to just skip the folding optimization in this case.
++
++Signed-off-by: Lukas Stockner <lukas@lukasstockner.de>
++Fixes: 19daf0aef84f ("powerpc/bpf/32: perform three operands ALU operations")
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 1 +
++ 1 file changed, 1 insertion(+)
++
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index f4f76ae61df9..6b3bd062b923 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -320,6 +320,7 @@ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *
++ 		if (i && (BPF_CLASS(code) == BPF_ALU64 || BPF_CLASS(code) == BPF_ALU) &&
++ 		    (BPF_CLASS(prevcode) == BPF_ALU64 || BPF_CLASS(prevcode) == BPF_ALU) &&
++ 		    BPF_OP(prevcode) == BPF_MOV && BPF_SRC(prevcode) == BPF_X &&
+++		    BPF_OP(code) != BPF_MOV &&
++ 		    insn[i - 1].dst_reg == insn[i].dst_reg && insn[i - 1].imm != 1) {
++ 			src2_reg = bpf_to_ppc(insn[i - 1].src_reg);
++ 			src2_reg_h = src2_reg - 1;
++-- 
++2.54.0
++
+diff --git a/target/linux/generic/pending-6.6/345-powerpc32-bpf-fetch-fifth-argument-in-BPF-subprogram.patch b/target/linux/generic/pending-6.6/345-powerpc32-bpf-fetch-fifth-argument-in-BPF-subprogram.patch
+new file mode 100644
+index 0000000000..91c9dfeba8
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/345-powerpc32-bpf-fetch-fifth-argument-in-BPF-subprogram.patch
+@@ -0,0 +1,38 @@
++From 424c51bbaca7229b6bdb3d2b9bebca4e5fbc4d2e Mon Sep 17 00:00:00 2001
++From: Lukas Stockner <lukas@lukasstockner.de>
++Date: Fri, 20 Nov 2026 15:31:41 +0100
++Subject: [PATCH 345/348] powerpc32/bpf: fetch fifth argument in BPF
++ subprograms
++
++Commit 7dd0e2848764 ("powerpc/bpf/32: BPF prog is never called with more than
++one arg") removed the BPF_REG_5 load since it's not used for program arguments,
++but that is only true for regular programs - subprograms may get up to five
++arguments, so the load is required there.
++
++Fixes: 7dd0e2848764 ("powerpc/bpf/32: BPF prog is never called with more than one arg")
++Signed-off-by: Lukas Stockner <lukas@lukasstockner.de>
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 7 +++++++
++ 1 file changed, 7 insertions(+)
++
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index 6b3bd062b923..d165ddbd4547 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -161,6 +161,13 @@ void bpf_jit_build_prologue(u32 *image, struct codegen_context *ctx)
++ 		if (bpf_is_seen_register(ctx, i))
++ 			EMIT(PPC_RAW_STW(i, _R1, bpf_jit_stack_offsetof(ctx, i)));
++ 
+++	/* If this is a subprogram, load fifth argument from the stack */
+++	if (ctx->is_subprog && bpf_is_seen_register(ctx, bpf_to_ppc(BPF_REG_5))) {
+++		int offset = bpf_has_stack_frame(ctx)? BPF_PPC_STACKFRAME(ctx) : 0;
+++		EMIT(PPC_RAW_LWZ(bpf_to_ppc(BPF_REG_5) - 1, _R1, offset + 8));
+++		EMIT(PPC_RAW_LWZ(bpf_to_ppc(BPF_REG_5), _R1, offset + 12));
+++	}
+++
++ 	/* Setup frame pointer to point to the bpf stack area */
++ 	if (bpf_is_seen_register(ctx, bpf_to_ppc(BPF_REG_FP))) {
++ 		EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_FP) - 1, 0));
++-- 
++2.54.0
++
+diff --git a/target/linux/generic/pending-6.6/346-powerpc32-bpf-consider-all-registers-as-used-in-call.patch b/target/linux/generic/pending-6.6/346-powerpc32-bpf-consider-all-registers-as-used-in-call.patch
+new file mode 100644
+index 0000000000..cfbaaa82c8
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/346-powerpc32-bpf-consider-all-registers-as-used-in-call.patch
+@@ -0,0 +1,59 @@
++From 3f6e28959705d54f9173fa9b3de6f630e491242c Mon Sep 17 00:00:00 2001
++From: Lukas Stockner <lukas@lukasstockner.de>
++Date: Fri, 20 Nov 2026 15:33:37 +0100
++Subject: [PATCH 346/348] powerpc32/bpf: consider all registers as used in
++ calls from a subprogram
++
++The JIT code tracks which registers are used and remaps based on that info,
++but currently does not account for the fact that function calls implicitly
++use registers because the called function will treat them as arguments.
++
++Therefore, if a function merely passes through one of its arguments
++to another function call, it will incorrectly be considered unused and may
++be overwritten with another register's contents.
++
++In practice, this only affects the fifth argument (since the other registers
++are masked out in bpf_jit_realloc_regs if there's a function call), and
++it only matters in subprograms since regular programs only receive one
++argument, so they'll have to touch R5 if they want to pass a fifth argument.
++
++Signed-off-by: Lukas Stockner <lukas@lukasstockner.de>
++Fixes: 51c66ad849a7 ("powerpc/bpf: Implement extended BPF on PPC32")
++Fixes: a8936569a07b ("powerpc/bpf: Always reallocate BPF_REG_5, BPF_REG_AX and TMP_REG when possible")
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 12 +++++++++++-
++ 1 file changed, 11 insertions(+), 1 deletion(-)
++
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index d165ddbd4547..6d3e953cad17 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -298,7 +298,7 @@ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *
++ {
++ 	const struct bpf_insn *insn = fp->insnsi;
++ 	int flen = fp->len;
++-	int i, ret;
+++	int i, ret, max_arg;
++ 
++ 	/* Start of epilogue code - will only be valid 2nd pass onwards */
++ 	u32 exit_addr = addrs[flen];
++@@ -1076,6 +1076,16 @@ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *
++ 			if (ret < 0)
++ 				return ret;
++ 
+++			/* We can't know which arguments the called function will use,
+++			 * so if this is a subprogram, assume the worst case where it
+++			 * uses all of them. Regular programs only get one argument,
+++			 * so any others would have been explicitly set. */
+++			max_arg = ctx->is_subprog ? BPF_REG_5 : BPF_REG_1;
+++			for (int reg = BPF_REG_1; reg <= max_arg; ++reg) {
+++				bpf_set_seen_register(ctx, bpf_to_ppc(reg) - 1);
+++				bpf_set_seen_register(ctx, bpf_to_ppc(reg));
+++			}
+++
++ 			if (bpf_is_seen_register(ctx, bpf_to_ppc(BPF_REG_5))) {
++ 				EMIT(PPC_RAW_STW(bpf_to_ppc(BPF_REG_5) - 1, _R1, 8));
++ 				EMIT(PPC_RAW_STW(bpf_to_ppc(BPF_REG_5), _R1, 12));
++-- 
++2.54.0
++
+diff --git a/target/linux/generic/pending-6.6/347-WIP-PPC32-kfunc-support.patch b/target/linux/generic/pending-6.6/347-WIP-PPC32-kfunc-support.patch
+new file mode 100644
+index 0000000000..d926ed554f
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/347-WIP-PPC32-kfunc-support.patch
+@@ -0,0 +1,121 @@
++From c4c90cd7ed3ca827c4403d81bb880f0f65f829b1 Mon Sep 17 00:00:00 2001
++From: Lukas Stockner <lukas@lukasstockner.de>
++Date: Fri, 20 Nov 2026 15:36:34 +0100
++Subject: [PATCH 347/348] WIP: PPC32 kfunc support
++
++[ Backport to 6.6: drop the fimage argument, 6.6 has no separate fimage. ]
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 90 +++++++++++++++++++++++++++++++
++ 1 file changed, 90 insertions(+)
++
++diff --git a/arch/powerpc/net/bpf_jit_comp32.c b/arch/powerpc/net/bpf_jit_comp32.c
++index 6d3e953cad17..494531415e30 100644
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -232,6 +232,89 @@ int bpf_jit_emit_func_call_rel(u32 *image, struct codegen_context *ctx, u64 func
++ 	return 0;
++ }
++ 
+++static int bpf_jit_emit_kfunc_call(struct bpf_prog *fp, u32 *image, struct codegen_context *ctx, const struct bpf_insn *insn, u64 func_addr)
+++{
+++	const struct btf_func_model *fm;
+++	int next_reg, next_stack, i, ret;
+++
+++	fm = bpf_jit_find_kfunc_model(fp, insn);
+++	if (!fm)
+++		return -EINVAL;
+++
+++	// kfunc arguments can only be pointers or integers, so as far as
+++	// we're concerned here it's only 32- or 64-bit integers.
+++	//
+++	// calling convention is to use r3-r10 for arguments.
+++	// 32-bit args simply use the next available register.
+++	// 64-bit args use two registers. If the next available register
+++	// is even, skip it: the arg always starts on an odd register.
+++	// If we run out of registers, remaining args are pushed to the
+++	// stack starting at 8(r1). 64-bit args again might need to skip
+++	// one slot for alignment.
+++
+++	// Since the eBPF argument registers are always 64-bit, we can just
+++	// sequentially move data as needed without needing to worry about
+++	// overwriting anything.
+++
+++	next_reg = _R3;
+++	next_stack = 8;
+++	for (i = 0; i < fm->nr_args; i++) {
+++		int bpf_reg_h, bpf_reg;
+++		bool is_u64;
+++
+++		if (i > 4)
+++			return -EINVAL;
+++		bpf_reg = bpf_to_ppc(BPF_REG_1 + i);
+++		bpf_reg_h = bpf_reg - 1;
+++		is_u64 = (fm->arg_size[i] > sizeof(u32));
+++
+++		// 64-bit arguments must start on odd-numbered registers.
+++		if (is_u64 && ((next_reg & 0x1) == 0))
+++			next_reg++;
+++		// When pushing to the stack, 64-bit arguments must also be
+++		// 8-byte aligned, but we never push more than one argument.
+++
+++		// Mark arguments as used.
+++		if (is_u64)
+++			bpf_set_seen_register(ctx, bpf_reg_h);
+++		bpf_set_seen_register(ctx, bpf_reg);
+++
+++		if (next_reg > 10) {
+++			// Need to push to the stack.
+++			if (is_u64) {
+++				EMIT(PPC_RAW_STW(bpf_reg_h, _R1, next_stack));
+++				next_stack += 4;
+++			}
+++			EMIT(PPC_RAW_STW(bpf_reg, _R1, next_stack));
+++			next_stack += 4;
+++		}
+++		else {
+++			if (is_u64) {
+++				if (bpf_reg_h != next_reg)
+++					EMIT(PPC_RAW_MR(next_reg, bpf_reg_h));
+++				next_reg++;
+++			}
+++			if (bpf_reg != next_reg)
+++				EMIT(PPC_RAW_MR(next_reg, bpf_reg));
+++			next_reg++;
+++		}
+++	}
+++
+++	ret = bpf_jit_emit_func_call_rel(image, ctx, func_addr);
+++	if (ret)
+++		return ret;
+++
+++	if (fm->ret_size > sizeof(u32)) {
+++		EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_0) - 1, _R3));
+++		EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_0), _R4));
+++	} else if (fm->ret_size) {
+++		EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_0) - 1, 0));
+++		EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_0), _R3));
+++	}
+++
+++	return 0;
+++}
+++
++ static int bpf_jit_emit_tail_call(u32 *image, struct codegen_context *ctx, u32 out)
