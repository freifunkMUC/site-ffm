+index 00000000000..cc9a7b4e5c8
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/346-powerpc-bpf-32-Fix-BPF_REG_1-and-BPF_REG_0-in-BPF-to.patch
+@@ -0,0 +1,95 @@
++From 65109f40e6e427c93e02e5cba087d54ce9361699 Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 06:23:43 +0200
++Subject: [PATCH 4/6] powerpc/bpf/32: Fix BPF_REG_1 and BPF_REG_0 in BPF-to-BPF
++ calls
++
++A BPF-to-BPF call is emitted like a helper call: BPF_REG_1 to
++BPF_REG_4 are already in r3:r4 to r9:r10 as 64-bit values, and on
++return BPF_REG_0 is taken from r3:r4. The callee however uses the same
++prologue and epilogue as a main program:
++
++- The prologue treats r3 as a 32-bit context pointer and sets BPF_REG_1
++  to (0:r3), so the callee gets the upper half of its first argument as
++  the lower half, and a subprogram that dereferences its context reads
++  from NULL.
++- The epilogue only returns the lower half of BPF_REG_0, in r3, so the
++  caller gets it as the upper half and whatever the callee left in r4
++  as the lower half.
++
++For example "call f; exit" with f doing "r0 = 0xa1a2a3a4b1b2b3b4; exit"
++returns 0 instead of 0xb1b2b3b4 on a WS-AP3715i (e500v2), and "r0 >>= 32"
++after the call gives 0xb1b2b3b4.
++
++Make subprograms follow the helper convention: skip the context pointer
++conversion in the prologue and return BPF_REG_0 in r3:r4. Subprograms
++are only entered through such calls, bpf_arch_text_poke() is not
++supported on PPC32.
++
++[ Backport to 6.6: there is no ctx->is_subprog yet. Add it to struct
++  codegen_context and set it from fp->aux->func_idx in
++  bpf_int_jit_compile(), the extra pass restores it from jit_data->ctx. ]
++
++Fixes: 51c66ad849a7 ("powerpc/bpf: Implement extended BPF on PPC32")
++Assisted-by: Claude:claude-opus-5
++---
++ arch/powerpc/net/bpf_jit.h        |  1 +
++ arch/powerpc/net/bpf_jit_comp.c   |  1 +
++ arch/powerpc/net/bpf_jit_comp32.c | 19 +++++++++++++++----
++ 3 files changed, 17 insertions(+), 4 deletions(-)
++
++--- a/arch/powerpc/net/bpf_jit.h
+++++ b/arch/powerpc/net/bpf_jit.h
++@@ -137,6 +137,7 @@ struct codegen_context {
++ 	int b2p[MAX_BPF_JIT_REG + 2];
++ 	unsigned int exentry_idx;
++ 	unsigned int alt_exit_addr;
+++	bool is_subprog;
++ };
++ 
++ #define bpf_to_ppc(r)	(ctx->b2p[r])
++--- a/arch/powerpc/net/bpf_jit_comp.c
+++++ b/arch/powerpc/net/bpf_jit_comp.c
++@@ -117,6 +117,7 @@ struct bpf_prog *bpf_int_jit_compile(str
++ 
++ 	/* Make sure that the stack is quadword aligned. */
++ 	cgctx.stack_size = round_up(fp->aux->stack_depth, 16);
+++	cgctx.is_subprog = fp->aux->func_idx != 0;
++ 
++ 	/* Scouting faux-generate pass 0 */
++ 	if (bpf_jit_build_body(fp, 0, &cgctx, addrs, 0, false)) {
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -142,9 +142,14 @@ void bpf_jit_build_prologue(u32 *image,
++ 	if (ctx->seen & SEEN_TAILCALL)
++ 		EMIT(PPC_RAW_STW(_R4, _R1, bpf_jit_stack_offsetof(ctx, BPF_PPC_TC)));
++ 
++-	/* First arg comes in as a 32 bits pointer. */
++-	EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_1), _R3));
++-	EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_1) - 1, 0));
+++	/*
+++	 * First arg comes in as a 32 bits pointer. Subprogs are called like
+++	 * helpers and get BPF_REG_1 in r3:r4 already.
+++	 */
+++	if (!ctx->is_subprog) {
+++		EMIT(PPC_RAW_MR(bpf_to_ppc(BPF_REG_1), _R3));
+++		EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_1) - 1, 0));
+++	}
++ 
++ 	/*
++ 	 * We need a stack frame, but we don't necessarily need to
++@@ -194,7 +199,13 @@ static void bpf_jit_emit_common_epilogue
++ 
++ void bpf_jit_build_epilogue(u32 *image, struct codegen_context *ctx)
++ {
++-	EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0)));
+++	/* Subprogs return all of BPF_REG_0 in r3:r4, like helpers */
+++	if (ctx->is_subprog) {
+++		EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0) - 1));
+++		EMIT(PPC_RAW_MR(_R4, bpf_to_ppc(BPF_REG_0)));
+++	} else {
+++		EMIT(PPC_RAW_MR(_R3, bpf_to_ppc(BPF_REG_0)));
+++	}
++ 
++ 	bpf_jit_emit_common_epilogue(image, ctx);
++ 
+diff --git a/target/linux/generic/pending-6.6/347-powerpc-bpf-32-Pass-BPF_REG_5-to-BPF-subprograms.patch b/target/linux/generic/pending-6.6/347-powerpc-bpf-32-Pass-BPF_REG_5-to-BPF-subprograms.patch
+new file mode 100644
+index 00000000000..95b302d85b7
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/347-powerpc-bpf-32-Pass-BPF_REG_5-to-BPF-subprograms.patch
+@@ -0,0 +1,72 @@
++From f1bfd5a41b99aa3cd2f2105ff834e657883598e0 Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 06:25:24 +0200
++Subject: [PATCH 5/6] powerpc/bpf/32: Pass BPF_REG_5 to BPF subprograms
++
++The caller of a BPF-to-BPF call stores BPF_REG_5 in its parameter area
++at 8(r1)/12(r1), like for a helper, but since commit 7dd0e2848764
++("powerpc/bpf/32: BPF prog is never called with more than one arg") the
++callee no longer loads it from there. The callee only sees the right
++value if both sides happen to keep BPF_REG_5 in r21:r22, which
++bpf_jit_realloc_regs() often changes: in
++
++	r5 = 0x55
++	call f
++	exit
++  f:	r0 = r5
++	exit
++
++the caller moves BPF_REG_5 to r5:r6 and the callee to r3:r4, so f
++returns the caller's BPF_REG_1 instead of 0x55.
++
++Load BPF_REG_5 from the caller's parameter area in the prologue of
++subprograms.
++
++A subprogram can also pass its own arguments to another one without
++using them. BPF_REG_5 is then neither loaded nor stored, and
++bpf_jit_realloc_regs() may move BPF_REG_5, BPF_REG_AX or TMP_REG into
++the registers still holding BPF_REG_1 to BPF_REG_4. Mark all argument
++registers as used in subprograms that call other subprograms.
++
++Fixes: 7dd0e2848764 ("powerpc/bpf/32: BPF prog is never called with more than one arg")
++Fixes: 40272035e1d0 ("powerpc/bpf: Reallocate BPF registers to volatile registers when possible on PPC32")
++Assisted-by: Claude:claude-opus-5
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 19 +++++++++++++++++++
++ 1 file changed, 19 insertions(+)
++
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -165,6 +165,14 @@ void bpf_jit_build_prologue(u32 *image,
++ 		if (bpf_is_seen_register(ctx, i))
++ 			EMIT(PPC_RAW_STW(i, _R1, bpf_jit_stack_offsetof(ctx, i)));
++ 
+++	/* Subprogs get BPF_REG_5 in the caller's parameter area, like helpers */
+++	if (ctx->is_subprog && bpf_is_seen_register(ctx, bpf_to_ppc(BPF_REG_5))) {
+++		int off = bpf_has_stack_frame(ctx) ? BPF_PPC_STACKFRAME(ctx) : 0;
+++
+++		EMIT(PPC_RAW_LWZ(bpf_to_ppc(BPF_REG_5) - 1, _R1, off + 8));
+++		EMIT(PPC_RAW_LWZ(bpf_to_ppc(BPF_REG_5), _R1, off + 12));
+++	}
+++
++ 	/* Setup frame pointer to point to the bpf stack area */
++ 	if (bpf_is_seen_register(ctx, bpf_to_ppc(BPF_REG_FP))) {
++ 		EMIT(PPC_RAW_LI(bpf_to_ppc(BPF_REG_FP) - 1, 0));
++@@ -1150,6 +1158,17 @@ static int __bpf_jit_build_body(struct b
++ 		case BPF_JMP | BPF_CALL:
++ 			ctx->seen |= SEEN_FUNC;
++ 
+++			/*
+++			 * A subprog may pass its own arguments on without using
+++			 * them: keep them where they are and load BPF_REG_5.
+++			 */
+++			if (ctx->is_subprog && insn[i].src_reg == BPF_PSEUDO_CALL) {
+++				for (int r = BPF_REG_1; r <= BPF_REG_5; r++) {
+++					bpf_set_seen_register(ctx, bpf_to_ppc(r));
+++					bpf_set_seen_register(ctx, bpf_to_ppc(r) - 1);
+++				}
+++			}
+++
++ 			ret = bpf_jit_get_func_addr(fp, &insn[i], extra_pass,
++ 						    &func_addr, &func_addr_fixed);
++ 			if (ret < 0)
+diff --git a/target/linux/generic/pending-6.6/348-bpf-tests-Add-tests-for-operations-following-a-MOV.patch b/target/linux/generic/pending-6.6/348-bpf-tests-Add-tests-for-operations-following-a-MOV.patch
