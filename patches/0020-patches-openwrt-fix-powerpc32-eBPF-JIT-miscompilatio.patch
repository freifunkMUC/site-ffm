+index 00000000000..3c4ccf5a7f4
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/343-powerpc-bpf-32-Only-fuse-a-MOV-into-operations-readi.patch
+@@ -0,0 +1,119 @@
++From 75db8693d76b69cab6501ae83ff92f29e29528ec Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 06:21:25 +0200
++Subject: [PATCH 1/6] powerpc/bpf/32: Only fuse a MOV into operations reading
++ src2_reg
++
++A MOV X followed by an ALU operation on the same register is emitted as
++a single operation that takes the MOV source (src2_reg) as its first
++operand, and the code already emitted for the MOV is discarded.
++
++That loses the move whenever the second instruction does not take its
++input from src2_reg:
++
++- The zero-extension the verifier inserts after a 32-bit MOV
++  (BPF_ZEXT_REG, imm == 1) only clears the upper half, so
++  "w5 = w0; w5 = w5" never sets the lower half of r5.
++- Other MOVs read src_reg (self moves, in-place sign extensions) or
++  nothing at all.
++- BPF_END works on dst_reg: FROM_BE 32/64 emits nothing on big-endian
++  and FROM_LE 16 inserts into the old dst_reg.
++- An operation whose source is the destination register reads the value
++  from before the move: "r5 = r0; r5 += r5" computes r0 + old r5.
++- Without verifier zero-extension (classic BPF, test_bpf) the upper half
++  is zero after a 32-bit MOV, but a fused 64-bit operation takes it from
++  src2_reg_h.
++
++The first case breaks real programs. Clang passes the result of one
++bpf_csum_diff() as the seed of the next with "w5 = w0", so on a
++WS-AP3715i (e500v2) every chained call of a CLAT program got seed 0 and
++the translated packets had bad L4 checksums. JIT output for
++"r0 = 0xaabbccdd11223344; r5 = 7; w5 = w0; w5 = w5; r0 = r5", where r5
++was reallocated to r3:r4:
++
++  1c:	li      r4,7
++  20:	li      r3,0
++  24:	li      r3,0
++  28:	mr      r12,r4
++
++BPF_PROG_TEST_RUN returns 7 instead of 0x11223344.
++
++Classic BPF is affected as well: DIV/MOD X is converted to "w7 = w7"
++followed by the division, so after "tax" the division uses the old X.
++
++Only fuse the MOV into operations that take their input from src2_reg,
++and not a 32-bit MOV into a 64-bit operation.
++
++Fixes: 19daf0aef84f ("powerpc/bpf/32: perform three operands ALU operations")
++Assisted-by: Claude:claude-opus-5
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 44 +++++++++++++++++++++++++++----
++ 1 file changed, 39 insertions(+), 5 deletions(-)
++
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -277,6 +277,44 @@ static int bpf_jit_emit_tail_call(u32 *i
++ 	return 0;
++ }
++ 
+++/*
+++ * Tell whether insn[i] can use the source of the preceding MOV as its first
+++ * operand (src2_reg) so that the MOV itself doesn't have to be emitted.
+++ */
+++static bool bpf_jit_fuse_with_mov(const struct bpf_insn *insn, int i)
+++{
+++	const struct bpf_insn *mov = &insn[i - 1];
+++	u8 code = insn[i].code;
+++
+++	if (BPF_CLASS(code) != BPF_ALU && BPF_CLASS(code) != BPF_ALU64)
+++		return false;
+++
+++	if (mov->code != (BPF_ALU64 | BPF_MOV | BPF_X) &&
+++	    mov->code != (BPF_ALU | BPF_MOV | BPF_X))
+++		return false;
+++
+++	/* The verifier's zero-extension is not a move */
+++	if (mov->imm == 1)
+++		return false;
+++
+++	if (mov->dst_reg != insn[i].dst_reg)
+++		return false;
+++
+++	/* A 32-bit MOV clears the upper half, src2_reg_h doesn't */
+++	if (BPF_CLASS(code) == BPF_ALU64 && BPF_CLASS(mov->code) == BPF_ALU)
+++		return false;
+++
+++	/* These don't take their input from src2_reg */
+++	if (BPF_OP(code) == BPF_MOV || BPF_OP(code) == BPF_END)
+++		return false;
+++
+++	/* The source register holds the moved value too */
+++	if (BPF_SRC(code) == BPF_X && insn[i].src_reg == insn[i].dst_reg)
+++		return false;
+++
+++	return true;
+++}
+++
++ /* Assemble the body code between the prologue & epilogue */
++ int bpf_jit_build_body(struct bpf_prog *fp, u32 *image, struct codegen_context *ctx,
++ 		       u32 *addrs, int pass, bool extra_pass)
++@@ -290,7 +328,6 @@ int bpf_jit_build_body(struct bpf_prog *
++ 
++ 	for (i = 0; i < flen; i++) {
++ 		u32 code = insn[i].code;
++-		u32 prevcode = i ? insn[i - 1].code : 0;
++ 		u32 dst_reg = bpf_to_ppc(insn[i].dst_reg);
++ 		u32 dst_reg_h = dst_reg - 1;
++ 		u32 src_reg = bpf_to_ppc(insn[i].src_reg);
++@@ -309,10 +346,7 @@ int bpf_jit_build_body(struct bpf_prog *
++ 		u32 tmp_idx;
++ 		int j;
++ 
++-		if (i && (BPF_CLASS(code) == BPF_ALU64 || BPF_CLASS(code) == BPF_ALU) &&
++-		    (BPF_CLASS(prevcode) == BPF_ALU64 || BPF_CLASS(prevcode) == BPF_ALU) &&
++-		    BPF_OP(prevcode) == BPF_MOV && BPF_SRC(prevcode) == BPF_X &&
++-		    insn[i - 1].dst_reg == insn[i].dst_reg && insn[i - 1].imm != 1) {
+++		if (i && bpf_jit_fuse_with_mov(insn, i)) {
++ 			src2_reg = bpf_to_ppc(insn[i - 1].src_reg);
++ 			src2_reg_h = src2_reg - 1;
++ 			ctx->idx = addrs[i - 1] / 4;
+diff --git a/target/linux/generic/pending-6.6/344-powerpc-bpf-32-Take-both-halves-from-the-fused-MOV-s.patch b/target/linux/generic/pending-6.6/344-powerpc-bpf-32-Take-both-halves-from-the-fused-MOV-s.patch
+new file mode 100644
+index 00000000000..4bb952d5492
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/344-powerpc-bpf-32-Take-both-halves-from-the-fused-MOV-s.patch
+@@ -0,0 +1,115 @@
++From 1848cf9bbf28b0df046818e712ceae65e9a091e7 Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 06:22:17 +0200
++Subject: [PATCH 2/6] powerpc/bpf/32: Take both halves from the fused MOV
++ source
++
++When a MOV is fused into the following ALU operation, the operation has
++to take all of its input from src2_reg/src2_reg_h. A few cases still use
++the destination register, or don't write a half they are supposed to
++copy:
++
++- OR/XOR K with imm == 0 emit nothing.
++- ALU64 OR/XOR K with imm >= 0 and AND K with imm < 0 don't set the
++  upper half.
++- ALU64 LSH K with imm == 0 only copies the lower half.
++- ALU64 MUL K with a power of two takes the bits shifted into the upper
++  half from dst_reg.
++- ALU64 DIV K with imm < 0 negates into dst_reg but still reads the
++  upper half from src2_reg_h afterwards.
++- ALU64 RSH X by 32 or more reads the upper half from dst_reg_h.
++
++As a result, "r5 = r0; r5 |= 0x100" leaves the old upper half in r5 and
++"r5 = r0; r5 >>= r4" with r4 >= 32 returns bits of the old r5.
++
++Use src2_reg/src2_reg_h in all of them. When nothing is fused both are
++the destination register, so the extra moves are only emitted for fused
++instructions.
++
++Fixes: 19daf0aef84f ("powerpc/bpf/32: perform three operands ALU operations")
++Assisted-by: Claude:claude-opus-5
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 16 ++++++++++++++--
++ 1 file changed, 14 insertions(+), 2 deletions(-)
++
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -469,7 +469,7 @@ int bpf_jit_build_body(struct bpf_prog *
++ 			} else if (imm > 0 && is_power_of_2(imm)) {
++ 				imm = ilog2(imm);
++ 				EMIT(PPC_RAW_RLWINM(dst_reg_h, src2_reg_h, imm, 0, 31 - imm));
++-				EMIT(PPC_RAW_RLWIMI(dst_reg_h, dst_reg, imm, 32 - imm, 31));
+++				EMIT(PPC_RAW_RLWIMI(dst_reg_h, src2_reg, imm, 32 - imm, 31));
++ 				EMIT(PPC_RAW_SLWI(dst_reg, src2_reg, imm));
++ 			} else {
++ 				bpf_set_seen_register(ctx, tmp_reg);
++@@ -547,6 +547,7 @@ int bpf_jit_build_body(struct bpf_prog *
++ 				EMIT(PPC_RAW_SUBFZE(dst_reg_h, src2_reg_h));
++ 				imm = -imm;
++ 				src2_reg = dst_reg;
+++				src2_reg_h = dst_reg_h;
++ 			}
++ 			if (imm == 1) {
++ 				EMIT(PPC_RAW_MR(dst_reg, src2_reg));
++@@ -579,6 +580,8 @@ int bpf_jit_build_body(struct bpf_prog *
++ 		case BPF_ALU64 | BPF_AND | BPF_K: /* dst = dst & imm */
++ 			if (imm >= 0)
++ 				EMIT(PPC_RAW_LI(dst_reg_h, 0));
+++			else if (src2_reg_h != dst_reg_h)
+++				EMIT(PPC_RAW_MR(dst_reg_h, src2_reg_h));
++ 			fallthrough;
++ 		case BPF_ALU | BPF_AND | BPF_K: /* (u32) dst = dst & imm */
++ 			if (!IMM_H(imm)) {
++@@ -604,6 +607,8 @@ int bpf_jit_build_body(struct bpf_prog *
++ 			/* Sign-extended */
++ 			if (imm < 0)
++ 				EMIT(PPC_RAW_LI(dst_reg_h, -1));
+++			else if (src2_reg_h != dst_reg_h)
+++				EMIT(PPC_RAW_MR(dst_reg_h, src2_reg_h));
++ 			fallthrough;
++ 		case BPF_ALU | BPF_OR | BPF_K:/* dst = (u32) dst | (u32) imm */
++ 			if (IMM_L(imm)) {
++@@ -612,6 +617,8 @@ int bpf_jit_build_body(struct bpf_prog *
++ 			}
++ 			if (IMM_H(imm))
++ 				EMIT(PPC_RAW_ORIS(dst_reg, src2_reg, IMM_H(imm)));
+++			else if (src2_reg != dst_reg)
+++				EMIT(PPC_RAW_MR(dst_reg, src2_reg));
++ 			break;
++ 		case BPF_ALU64 | BPF_XOR | BPF_X: /* dst ^= src */
++ 			if (dst_reg == src_reg) {
++@@ -631,6 +638,8 @@ int bpf_jit_build_body(struct bpf_prog *
++ 		case BPF_ALU64 | BPF_XOR | BPF_K: /* dst ^= imm */
++ 			if (imm < 0)
++ 				EMIT(PPC_RAW_NOR(dst_reg_h, src2_reg_h, src2_reg_h));
+++			else if (src2_reg_h != dst_reg_h)
+++				EMIT(PPC_RAW_MR(dst_reg_h, src2_reg_h));
++ 			fallthrough;
++ 		case BPF_ALU | BPF_XOR | BPF_K: /* (u32) dst ^= (u32) imm */
++ 			if (IMM_L(imm)) {
++@@ -639,6 +648,8 @@ int bpf_jit_build_body(struct bpf_prog *
++ 			}
++ 			if (IMM_H(imm))
++ 				EMIT(PPC_RAW_XORIS(dst_reg, src2_reg, IMM_H(imm)));
+++			else if (src2_reg != dst_reg)
+++				EMIT(PPC_RAW_MR(dst_reg, src2_reg));
++ 			break;
++ 		case BPF_ALU | BPF_LSH | BPF_X: /* (u32) dst <<= (u32) src */
++ 			EMIT(PPC_RAW_SLW(dst_reg, src2_reg, src_reg));
++@@ -665,6 +676,7 @@ int bpf_jit_build_body(struct bpf_prog *
++ 				return -EINVAL;
++ 			if (!imm) {
++ 				EMIT(PPC_RAW_MR(dst_reg, src2_reg));
+++				EMIT(PPC_RAW_MR(dst_reg_h, src2_reg_h));
++ 			} else if (imm < 32) {
++ 				EMIT(PPC_RAW_RLWINM(dst_reg_h, src2_reg_h, imm, 0, 31 - imm));
++ 				EMIT(PPC_RAW_RLWIMI(dst_reg_h, src2_reg, imm, 32 - imm, 31));
++@@ -686,7 +698,7 @@ int bpf_jit_build_body(struct bpf_prog *
++ 			EMIT(PPC_RAW_SRW(dst_reg, src2_reg, src_reg));
++ 			EMIT(PPC_RAW_ADDI(tmp_reg, src_reg, 32));
++ 			EMIT(PPC_RAW_SLW(_R0, src2_reg_h, _R0));
++-			EMIT(PPC_RAW_SRW(tmp_reg, dst_reg_h, tmp_reg));
+++			EMIT(PPC_RAW_SRW(tmp_reg, src2_reg_h, tmp_reg));
++ 			EMIT(PPC_RAW_OR(dst_reg, dst_reg, _R0));
++ 			EMIT(PPC_RAW_SRW(dst_reg_h, src2_reg_h, src_reg));
++ 			EMIT(PPC_RAW_OR(dst_reg, dst_reg, tmp_reg));
+diff --git a/target/linux/generic/pending-6.6/345-powerpc-bpf-32-Don-t-fuse-a-MOV-into-a-branch-target.patch b/target/linux/generic/pending-6.6/345-powerpc-bpf-32-Don-t-fuse-a-MOV-into-a-branch-target.patch
+new file mode 100644
+index 00000000000..09a0206c6d8
+--- /dev/null
++++ b/target/linux/generic/pending-6.6/345-powerpc-bpf-32-Don-t-fuse-a-MOV-into-a-branch-target.patch
+@@ -0,0 +1,152 @@
++From c8d108cf0f5c8ae8bff500e47d81e00107a8f4c3 Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 06:23:05 +0200
++Subject: [PATCH 3/6] powerpc/bpf/32: Don't fuse a MOV into a branch target
++
++When a MOV is fused into the following ALU operation, the address of the
++ALU operation becomes the address of the MOV, and the emitted code
++computes the result from the MOV source. A branch to the ALU operation
++then also lands there, although the MOV was not executed on that path:
++
++	r5 = 7
++	if w2 > 1 goto l0
++	r5 = r0
++  l0:	r5 += 1
++
++JITs to
++
++	li      r8,7
++	li      r7,0
++	cmplwi  r6,1
++	bgt     l0
++	nop
++  l0:	addic   r8,r12,1
++	addze   r7,r11
++
++so the taken branch computes r0 + 1 instead of 8. Classic BPF programs
++get there with a jump over "txa".
++
++Record which instructions are branch targets before generating code and
++don't fuse into them.
++
++[ Backport to 6.6: bpf_jit_build_body() has no fimage argument. The 6.6
++  JIT doesn't implement BPF_JMP32 | BPF_JA and rejects such programs, the
++  imm case in bpf_jit_find_jmp_targets() is kept as it is harmless. ]
++
++Fixes: 19daf0aef84f ("powerpc/bpf/32: perform three operands ALU operations")
++Assisted-by: Claude:claude-opus-5
++---
++ arch/powerpc/net/bpf_jit_comp32.c | 66 ++++++++++++++++++++++++++++---
++ 1 file changed, 61 insertions(+), 5 deletions(-)
++
++--- a/arch/powerpc/net/bpf_jit_comp32.c
+++++ b/arch/powerpc/net/bpf_jit_comp32.c
++@@ -7,6 +7,7 @@
++  *
++  * Based on PPC64 eBPF JIT compiler by Naveen N. Rao
++  */
+++#include <linux/bitmap.h>
++ #include <linux/moduleloader.h>
++ #include <asm/cacheflush.h>
++ #include <asm/asm-compat.h>
++@@ -277,11 +278,44 @@ static int bpf_jit_emit_tail_call(u32 *i
++ 	return 0;
++ }
++ 
+++static unsigned long *bpf_jit_find_jmp_targets(const struct bpf_prog *fp)
+++{
+++	const struct bpf_insn *insn = fp->insnsi;
+++	unsigned long *targets;
+++	int i;
+++
+++	targets = bitmap_zalloc(fp->len, GFP_KERNEL);
+++	if (!targets)
+++		return NULL;
+++
+++	for (i = 0; i < fp->len; i++) {
+++		u8 class = BPF_CLASS(insn[i].code);
+++		u8 op = BPF_OP(insn[i].code);
+++		int target;
+++
+++		if (class != BPF_JMP && class != BPF_JMP32)
+++			continue;
+++		if (op == BPF_CALL || op == BPF_EXIT || op == BPF_TAIL_CALL)
+++			continue;
+++
+++		if (class == BPF_JMP32 && op == BPF_JA)
+++			target = i + 1 + insn[i].imm;
+++		else
+++			target = i + 1 + insn[i].off;
+++
+++		if (target >= 0 && target < fp->len)
+++			__set_bit(target, targets);
+++	}
+++
+++	return targets;
+++}
+++
++ /*
++  * Tell whether insn[i] can use the source of the preceding MOV as its first
++  * operand (src2_reg) so that the MOV itself doesn't have to be emitted.
++  */
++-static bool bpf_jit_fuse_with_mov(const struct bpf_insn *insn, int i)
+++static bool bpf_jit_fuse_with_mov(const struct bpf_insn *insn, int i,
+++				  const unsigned long *jmp_targets)
++ {
++ 	const struct bpf_insn *mov = &insn[i - 1];
++ 	u8 code = insn[i].code;
++@@ -289,6 +323,10 @@ static bool bpf_jit_fuse_with_mov(const
