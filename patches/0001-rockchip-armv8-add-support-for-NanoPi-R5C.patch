From 3ed00031dc0cbd7143879e6b1e19aad7193cc596 Mon Sep 17 00:00:00 2001
From: Tobias <5702338+T0biii@users.noreply.github.com>
Date: Wed, 21 Jan 2026 18:41:51 +0000
Subject: [PATCH] rockchip-armv8: add support for NanoPi R5C

---
 package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac | 1 +
 targets/rockchip-armv8                                      | 1 +
 2 files changed, 2 insertions(+)

diff --git a/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac b/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
index 49b4bf0a..6e455e00 100755
--- a/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
+++ b/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
@@ -112,6 +112,7 @@ local primary_addrs = {
 			'friendlyarm,nanopi-r2s',
 			'friendlyarm,nanopi-r3s',
 			'friendlyarm,nanopi-r4s',
+			'friendlyarm,nanopi-r5c',
 		}},
 		{'x86'},
 	}},
diff --git a/targets/rockchip-armv8 b/targets/rockchip-armv8
index 9cc8a220..7be2ef2f 100644
--- a/targets/rockchip-armv8
+++ b/targets/rockchip-armv8
@@ -6,3 +6,4 @@ defaults {
 device('friendlyelec-nanopi-r2s', 'friendlyarm_nanopi-r2s')
 device('friendlyelec-nanopi-r3s', 'friendlyarm_nanopi-r3s')
 device('friendlyelec-nanopi-r4s', 'friendlyarm_nanopi-r4s') -- 4GB LPDDR4
+device('friendlyelec-nanopi-r5c', 'friendlyarm_nanopi-r5c')
-- 
2.52.0

