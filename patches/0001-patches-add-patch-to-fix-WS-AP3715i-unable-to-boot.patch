From 5bb9efaa3456c061fa3038e9e651ecd4874a7767 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Fri, 18 Sep 2026 17:59:47 +0200
Subject: [PATCH] patches: add patch to fix WS-AP3715i unable to boot

---
 ...-remaining-simpleImage-devices-to-0x.patch | 124 ++++++++++++++++++
 1 file changed, 124 insertions(+)
 create mode 100644 patches/openwrt/0014-mpc85xx-relocate-remaining-simpleImage-devices-to-0x.patch

diff --git a/patches/openwrt/0014-mpc85xx-relocate-remaining-simpleImage-devices-to-0x.patch b/patches/openwrt/0014-mpc85xx-relocate-remaining-simpleImage-devices-to-0x.patch
new file mode 100644
index 00000000..e4c5c4dc
--- /dev/null
+++ b/patches/openwrt/0014-mpc85xx-relocate-remaining-simpleImage-devices-to-0x.patch
@@ -0,0 +1,124 @@
+From 557b4789919c9ed0cfd82669d99030fe607d7f41 Mon Sep 17 00:00:00 2001
+From: Grische <github@grische.xyz>
+Date: Thu, 17 Sep 2026 12:06:41 +0200
+Subject: [PATCH] mpc85xx: relocate remaining simpleImage devices to 0x3000000
+
+WS-AP3715i fails to boot as its simpleImage loader is not linked at a
+fixed address. WS-AP3825i fails to boot its initramfs image as the
+kernel exceeds the space available below the loader. HiveAP-330,
+WS-AP3710i and BR200-WP are within 0.2 MiB of the same limit.
+
+Relocate the simpleImage loader of all five devices to 0x3000000.
+
+Link: https://github.com/openwrt/openwrt/issues/23112
+Signed-off-by: Grische <github@grische.xyz>
+Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
+---
+ target/linux/mpc85xx/image/p1010.mk           |  8 ++---
+ target/linux/mpc85xx/image/p1020.mk           | 12 ++++----
+ ...locate-remaining-simpleimage-devices.patch | 30 +++++++++++++++++++
+ 3 files changed, 40 insertions(+), 10 deletions(-)
+ create mode 100644 target/linux/mpc85xx/patches-6.6/113-mpc85xx-relocate-remaining-simpleimage-devices.patch
+
+diff --git a/target/linux/mpc85xx/image/p1010.mk b/target/linux/mpc85xx/image/p1010.mk
+index c873c29f9d..ddfff8cb3a 100644
+--- a/target/linux/mpc85xx/image/p1010.mk
++++ b/target/linux/mpc85xx/image/p1010.mk
+@@ -21,8 +21,8 @@ define Device/aerohive_br200-wp
+   KERNEL_NAME := simpleImage.br200-wp
+   KERNEL := kernel-bin | uImage none
+   KERNEL_INITRAMFS := kernel-bin | uImage none
+-  KERNEL_ENTRY := 0x1500000
+-  KERNEL_LOADADDR := 0x1500000
++  KERNEL_ENTRY := 0x3000000
++  KERNEL_LOADADDR := 0x3000000
+   KERNEL_SIZE := 8m
+   IMAGES := fdt.bin sysupgrade.bin
+   IMAGE/fdt.bin := append-dtb
+@@ -39,8 +39,8 @@ define Device/enterasys_ws-ap3715i
+   DEVICE_MODEL := WS-AP3715i
+   BLOCKSIZE := 64k
+   KERNEL_NAME := simpleImage.ws-ap3715i
+-  KERNEL_ENTRY := 0x1500000
+-  KERNEL_LOADADDR := 0x1500000
++  KERNEL_ENTRY := 0x3000000
++  KERNEL_LOADADDR := 0x3000000
+   KERNEL = kernel-bin | lzma | uImage lzma
+   IMAGES := sysupgrade.bin
+   IMAGE/sysupgrade.bin := append-kernel | append-rootfs | pad-rootfs | append-metadata
+diff --git a/target/linux/mpc85xx/image/p1020.mk b/target/linux/mpc85xx/image/p1020.mk
+index c310b26c87..537dc5eabc 100644
+--- a/target/linux/mpc85xx/image/p1020.mk
++++ b/target/linux/mpc85xx/image/p1020.mk
+@@ -22,8 +22,8 @@ define Device/aerohive_hiveap-330
+   KERNEL_NAME := simpleImage.hiveap-330
+   KERNEL_SIZE := 16m
+   IMAGES := sysupgrade.bin
+-  KERNEL_ENTRY := 0x1500000
+-  KERNEL_LOADADDR := 0x1500000
++  KERNEL_ENTRY := 0x3000000
++  KERNEL_LOADADDR := 0x3000000
+   # append-dtb is still needed, as otherwise u-boot bootm complains
+   # about not having a FDT to edit.
+   IMAGE/sysupgrade.bin := append-dtb | pad-to 256k | append-kernel | \
+@@ -68,8 +68,8 @@ define Device/enterasys_ws-ap3710i
+   DEVICE_MODEL := WS-AP3710i
+   BLOCKSIZE := 128k
+   KERNEL_NAME := simpleImage.ws-ap3710i
+-  KERNEL_ENTRY := 0x1500000
+-  KERNEL_LOADADDR := 0x1500000
++  KERNEL_ENTRY := 0x3000000
++  KERNEL_LOADADDR := 0x3000000
+   KERNEL = kernel-bin | uImage none
+   KERNEL_INITRAMFS := kernel-bin | uImage none
+   IMAGES := sysupgrade.bin
+@@ -83,8 +83,8 @@ define Device/extreme-networks_ws-ap3825i
+   DEVICE_PACKAGES := kmod-ath10k-ct ath10k-firmware-qca988x-ct
+   BLOCKSIZE := 128k
+   KERNEL_NAME := simpleImage.ws-ap3825i
+-  KERNEL_ENTRY := 0x1500000
+-  KERNEL_LOADADDR := 0x1500000
++  KERNEL_ENTRY := 0x3000000
++  KERNEL_LOADADDR := 0x3000000
+   KERNEL = kernel-bin | fit none $(KDIR)/image-$$(DEVICE_DTS).dtb
+   IMAGES := sysupgrade.bin
+   IMAGE/sysupgrade.bin := append-kernel | append-rootfs | pad-rootfs | append-metadata
+diff --git a/target/linux/mpc85xx/patches-6.6/113-mpc85xx-relocate-remaining-simpleimage-devices.patch b/target/linux/mpc85xx/patches-6.6/113-mpc85xx-relocate-remaining-simpleimage-devices.patch
+new file mode 100644
+index 0000000000..40a8da5444
+--- /dev/null
++++ b/target/linux/mpc85xx/patches-6.6/113-mpc85xx-relocate-remaining-simpleimage-devices.patch
+@@ -0,0 +1,30 @@
++From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
++From: Grische <github@grische.xyz>
++Date: Thu, 17 Sep 2026 12:06:41 +0200
++Subject: [PATCH] powerpc: mpc85xx: relocate remaining simpleImage devices
++
++Link the simpleImage loader of HiveAP-330, BR200-WP, WS-AP3710i,
++WS-AP3715i and WS-AP3825i at 0x3000000, so their kernels no longer
++exceed the space available below the loader.
++
++Signed-off-by: Grische <github@grische.xyz>
++---
++--- a/arch/powerpc/boot/wrapper
+++++ b/arch/powerpc/boot/wrapper
++@@ -350,10 +350,15 @@
++     ;;
++ simpleboot-br200-wp|\
++ simpleboot-hiveap-330|\
++-simpleboot-tl-wdr4900-v1|\
++ simpleboot-ws-ap3710i|\
+++simpleboot-ws-ap3715i|\
++ simpleboot-ws-ap3825i)
++     platformo="$object/fixed-head.o $object/simpleboot.o"
+++    link_address='0x3000000'
+++    binary=y
+++    ;;
+++simpleboot-tl-wdr4900-v1)
+++    platformo="$object/fixed-head.o $object/simpleboot.o"
++     link_address='0x1500000'
++     binary=y
++     ;;
+-- 
+2.52.0
+
-- 
2.52.0

