+   nanopi-r3s-rk3566 \
+diff --git a/package/boot/uboot-rockchip/patches/001-01-v2027.01-arm64-dts-rockchip-Add-watchdog-node-for-RK3528.patch b/package/boot/uboot-rockchip/patches/001-01-v2027.01-arm64-dts-rockchip-Add-watchdog-node-for-RK3528.patch
