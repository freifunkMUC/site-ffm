@@ -0,0 +1,2503 @@
+From: Grische <github@grische.xyz>
+Date: Thu, 19 Nov 2026 19:24:06 +0100
+Subject: uboot-rockchip: backport NanoPi R28S support from U-Boot next
+
+Upstream U-Boot merged version 3 of the NanoPi R28S series into next
+for v2027.04. Unlike version 1, it adds no defconfig for the R28S. The
+nanopi-zero2-rk3528 defconfig builds one image with the devicetrees of
+both boards. U-Boot selects the devicetree by the HW_ID voltage on
+SARADC channel 2.
+
+Replace the R28S patches with cherry-picks of the six merged commits
+and build the R28S U-Boot from the nanopi-zero2-rk3528 target. Because
+the commits are in next, the update to U-Boot v2027.04 can drop these
+patches.
+
+Signed-off-by: Grische <github@grische.xyz>
+Assisted-by: Claude:claude-opus-5-5
+
+diff --git a/package/boot/uboot-rockchip/Makefile b/package/boot/uboot-rockchip/Makefile
+index 48b5330357c1e0c990a040be79b0a60b25a8cc1d..b45a99e6a64c83a9a3935d44f81e4c66a0a5344a 100644
+--- a/package/boot/uboot-rockchip/Makefile
++++ b/package/boot/uboot-rockchip/Makefile
+@@ -188,9 +188,9 @@ define U-Boot/hinlink-h28k-rk3528
+     hinlink_h28k
+ endef
+ 
+-define U-Boot/nanopi-r28s-rk3528
++define U-Boot/nanopi-zero2-rk3528
+   $(U-Boot/rk3528/Default)
+-  NAME:=NanoPi R28S
++  NAME:=NanoPi R28S/Zero2
+   BUILD_DEVICES:= \
+     friendlyarm_nanopi-r28s
+ endef
+@@ -464,7 +464,7 @@ UBOOT_TARGETS := \
+   rock-pi-e-rk3328 \
+   rock-pi-e-v3-rk3328 \
+   hinlink-h28k-rk3528 \
+-  nanopi-r28s-rk3528 \
++  nanopi-zero2-rk3528 \
+   radxa-e20c-rk3528 \
+   rock-2-rk3528 \
+   nanopi-r3s-rk3566 \
+diff --git a/package/boot/uboot-rockchip/patches/002-01-v2027.04-dt-bindings-arm-rockchip-Add-FriendlyElec-NanoPi-R28S.patch b/package/boot/uboot-rockchip/patches/002-01-v2027.04-dt-bindings-arm-rockchip-Add-FriendlyElec-NanoPi-R28S.patch
