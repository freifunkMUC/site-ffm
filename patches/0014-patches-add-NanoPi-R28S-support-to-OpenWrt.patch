+-+};
+-+
+-+&sdmmc {
+-+	bus-width = <4>;
+-+	cap-mmc-highspeed;
+-+	cap-sd-highspeed;
+-+	disable-wp;
+-+	sd-uhs-sdr104;
+-+	vmmc-supply = <&vcc3v3_sd>;
+-+	vqmmc-supply = <&vccio_sd>;
+-+	status = "okay";
+-+};
+-+
+-+&uart0 {
+-+	pinctrl-names = "default";
+-+	pinctrl-0 = <&uart0m0_xfer>;
+-+	status = "okay";
+-+};
+diff --git a/package/boot/uboot-rockchip/patches/109-2-arm64-dts-rockchip-Add-devicetree-for-the-FriendlyElec-Na.patch b/package/boot/uboot-rockchip/patches/109-2-arm64-dts-rockchip-Add-devicetree-for-the-FriendlyElec-Na.patch
+deleted file mode 100644
+index e22fe8c4dca2a3c997a8dcad71ff230d0b6adb5d..0000000000000000000000000000000000000000
+--- a/package/boot/uboot-rockchip/patches/109-2-arm64-dts-rockchip-Add-devicetree-for-the-FriendlyElec-Na.patch
++++ /dev/null
+@@ -1,204 +0,0 @@
+-From c1e23f3425c49fe22e9598f8eea2fcf693950d50 Mon Sep 17 00:00:00 2001
+-From: 安容 <HystericalDragons@proton.me>
+-Date: Sat, 19 Sep 2026 18:28:19 +0800
+-Subject: [PATCH] arm64: dts: rockchip: Add devicetree for the FriendlyElec
+- NanoPi R28S
+-MIME-Version: 1.0
+-Content-Type: text/plain; charset=UTF-8
+-Content-Transfer-Encoding: 8bit
+-
+-The NanoPi R28S is a dual gigabit Ethernet router board based on the
+-Rockchip RK3528 SoC, designed and developed by FriendlyElec. It shares
+-most of its design with the NanoPi Zero2, so it builds on the common
+-rk3528-nanopi.dtsi.
+-
+-Specification:
+-- Rockchip RK3528
+-- 1GB RAM
+-- eMMC socket (optional)
+-- MicroSD slot
+-- 1x 1000Base-T (GMAC1, Realtek RTL8211F)
+-- 1x 1000Base-T (PCIe, Realtek RTL8111H)
+-- AICSemi AIC8800D80 SDIO WiFi + Bluetooth
+-- 3x LEDs (SYS, LAN, WAN)
+-- 1x USB 2.0 Type-C OTG, shared with the 5V power input
+-- User and MaskROM buttons
+-- Haoyu HYM8563 RTC
+-- 1x USB Type-C debug UART (onboard WCH CH340E)
+-
+-The AIC8800D80 has no upstream driver yet, so only the SDIO and UART
+-controllers it hangs off are enabled, along with the WiFi and Bluetooth
+-wake and power pins taken from the schematics.
+-
+-Assisted-by: LLM
+-Signed-off-by: 安容 <HystericalDragons@proton.me>
+-Link: https://patch.msgid.link/20260919-r28s-upstream-v7-3-e80a6f8ef521@proton.me
+-Signed-off-by: Heiko Stuebner <heiko@sntech.de>
+----
+- .../src/arm64/rockchip/rk3528-nanopi-r28s.dts | 160 ++++++++++++++++++
+- 1 file changed, 160 insertions(+)
+- create mode 100644 dts/upstream/src/arm64/rockchip/rk3528-nanopi-r28s.dts
+-
+---- /dev/null
+-+++ b/dts/upstream/src/arm64/rockchip/rk3528-nanopi-r28s.dts
+-@@ -0,0 +1,160 @@
+-+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+-+/*
+-+ * Copyright (c) 2022 Rockchip Electronics Co., Ltd.
+-+ * Copyright (c) 2026 FriendlyElec Computer Tech. Co., Ltd.
+-+ * Copyright (c) 2026 安容 <HystericalDragons@proton.me>
+-+ */
+-+
+-+/dts-v1/;
+-+
+-+#include "rk3528-nanopi.dtsi"
+-+
+-+/ {
+-+	model = "FriendlyElec NanoPi R28S";
+-+	compatible = "friendlyarm,nanopi-r28s", "rockchip,rk3528";
+-+
+-+	aliases {
+-+		mmc2 = &sdio0;
+-+		serial2 = &uart2;
+-+	};
+-+
+-+	gpio-keys {
+-+		compatible = "gpio-keys";
+-+		pinctrl-names = "default";
+-+		pinctrl-0 = <&gpio4_b2_usr_btn>;
+-+
+-+		button-user {
+-+			debounce-interval = <50>;
+-+			gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_LOW>;
+-+			label = "USER";
+-+			linux,code = <BTN_1>;
+-+			wakeup-source;
+-+		};
+-+	};
+-+
+-+	sdio_pwrseq: sdio-pwrseq {
+-+		compatible = "mmc-pwrseq-simple";
+-+		pinctrl-names = "default";
+-+		pinctrl-0 = <&pwr_wf>;
+-+		post-power-on-delay-ms = <100>;
+-+		reset-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_LOW>;
+-+	};
+-+};
+-+
+-+&combphy {
+-+	status = "okay";
+-+};
+-+
+-+&led1 {
+-+	default-state = "off";
+-+	function = LED_FUNCTION_WAN;
+-+	linux,default-trigger = "netdev";
+-+};
+-+
+-+&leds {
+-+	pinctrl-names = "default";
+-+	pinctrl-0 = <&led_sys_pin>, <&led1_pin>, <&led2_pin>;
+-+
+-+	led-2 {
+-+		color = <LED_COLOR_ID_GREEN>;
+-+		default-state = "off";
+-+		function = LED_FUNCTION_LAN;
+-+		gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
+-+		linux,default-trigger = "netdev";
+-+	};
+-+};
+-+
+-+&pcie {
+-+	pinctrl-names = "default";
+-+	pinctrl-0 = <&pcie_eth_perstb>;
+-+	reset-gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
+-+	vpcie3v3-supply = <&vcc_3v3>;
+-+	status = "okay";
+-+};
+-+
+-+&pinctrl {
+-+	bluetooth {
+-+		bt_wake_host: bt-wake-host {
+-+			rockchip,pins = <1 RK_PB5 RK_FUNC_GPIO &pcfg_pull_down>;
+-+		};
+-+
+-+		host_wake_bt: host-wake-bt {
+-+			rockchip,pins = <1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
+-+		};
+-+	};
+-+
+-+	gpio-keys {
+-+		gpio4_b2_usr_btn: gpio4-b2-usr-btn {
+-+			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
+-+		};
+-+	};
+-+
+-+	leds {
+-+		led2_pin: led2-pin {
+-+			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
+-+		};
+-+	};
+-+
+-+	pcie {
+-+		pcie_eth_perstb: pcie-eth-perstb {
+-+			rockchip,pins = <4 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
+-+		};
+-+	};
+-+
+-+	wifi {
+-+		host_wake_wl: host-wake-wl {
+-+			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+-+		};
+-+
+-+		pwr_wf: pwr-wf {
+-+			rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
+-+		};
+-+
+-+		wl_wake_host: wl-wake-host {
+-+			rockchip,pins = <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_down>;
+-+		};
+-+	};
+-+};
+-+
+-+&sdio0 {
+-+	bus-width = <4>;
+-+	cap-sd-highspeed;
+-+	cap-sdio-irq;
+-+	keep-power-in-suspend;
+-+	mmc-pwrseq = <&sdio_pwrseq>;
+-+	no-mmc;
+-+	no-sd;
+-+	non-removable;
+-+	sd-uhs-sdr104;
+-+	vmmc-supply = <&vcc_3v3>;
+-+	vqmmc-supply = <&vcc_1v8>;
+-+	status = "okay";
+-+};
+-+
+-+&uart2 {
+-+	dma-names = "tx", "rx";
+-+	pinctrl-names = "default";
+-+	pinctrl-0 = <&uart2m1_xfer>, <&uart2m1_ctsn>, <&uart2m1_rtsn>;
+-+	uart-has-rtscts;
+-+	status = "okay";
+-+};
+-+
+-+&usb_host0_xhci {
+-+	/*
+-+	 * The Type-C port is also the 5V power input, so it comes up as a
+-+	 * device, but host mode works with an externally powered hub.
+-+	 */
+-+	extcon = <&usb2phy>;
+-+	maximum-speed = "high-speed";
+-+	phys = <&usb2phy_otg>;
+-+	phy-names = "usb2-phy";
+-+	status = "okay";
+-+};
+-+
+-+&usb2phy {
+-+	status = "okay";
+-+};
+-+
+-+&usb2phy_otg {
+-+	status = "okay";
+-+};
+diff --git a/package/boot/uboot-rockchip/patches/109-3-rockchip-rk3528-Split-out-common-NanoPi-u-boot.dtsi.patch b/package/boot/uboot-rockchip/patches/109-3-rockchip-rk3528-Split-out-common-NanoPi-u-boot.dtsi.patch
+deleted file mode 100644
+index 6a50cd0508448e674b70abd7623c7dc8e443b9e2..0000000000000000000000000000000000000000
+--- a/package/boot/uboot-rockchip/patches/109-3-rockchip-rk3528-Split-out-common-NanoPi-u-boot.dtsi.patch
++++ /dev/null
+@@ -1,64 +0,0 @@
+-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+-From: 安容 <HystericalDragons@proton.me>
+-Date: Mon, 12 Oct 2026 14:55:42 +0800
+-Subject: [PATCH] rockchip: rk3528: Split out common NanoPi u-boot.dtsi
+-MIME-Version: 1.0
+-Content-Type: text/plain; charset=UTF-8
+-Content-Transfer-Encoding: 8bit
+-
+-The Linux devicetree of the NanoPi Zero2 has been split into a common
+-rk3528-nanopi.dtsi, which the NanoPi R28S builds on. Both boards use
+-the same PWM regulators for vdd_arm and vdd_logic.
+-
+-Move the U-Boot specific parts of the NanoPi Zero2 into a common
+-rk3528-nanopi-u-boot.dtsi in the same way, so that the NanoPi R28S can
+-include it instead of duplicating it. No functional change.
+-
+-Signed-off-by: 安容 <HystericalDragons@proton.me>
+-Link: https://lore.kernel.org/all/20261012-nanopi-r28s-v1-1-042d62597829@proton.me/
+----
+- arch/arm/dts/rk3528-nanopi-u-boot.dtsi       | 11 +++++++++++
+- arch/arm/dts/rk3528-nanopi-zero2-u-boot.dtsi | 10 +---------
+- arch/arm/mach-rockchip/rk3528/MAINTAINERS    |  1 +
+- 3 files changed, 13 insertions(+), 9 deletions(-)
+- create mode 100644 arch/arm/dts/rk3528-nanopi-u-boot.dtsi
+-
+---- /dev/null
+-+++ b/arch/arm/dts/rk3528-nanopi-u-boot.dtsi
+-@@ -0,0 +1,11 @@
+-+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+-+
+-+#include "rk3528-u-boot.dtsi"
+-+
+-+&vdd_arm {
+-+	regulator-init-microvolt = <953000>;
+-+};
+-+
+-+&vdd_logic {
+-+	regulator-init-microvolt = <900000>;
+-+};
+---- a/arch/arm/dts/rk3528-nanopi-zero2-u-boot.dtsi
+-+++ b/arch/arm/dts/rk3528-nanopi-zero2-u-boot.dtsi
+-@@ -1,11 +1,3 @@
+- // SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+- 
+--#include "rk3528-u-boot.dtsi"
+--
+--&vdd_arm {
+--	regulator-init-microvolt = <953000>;
+--};
+--
+--&vdd_logic {
+--	regulator-init-microvolt = <900000>;
+--};
+-+#include "rk3528-nanopi-u-boot.dtsi"
+---- a/arch/arm/mach-rockchip/rk3528/MAINTAINERS
+-+++ b/arch/arm/mach-rockchip/rk3528/MAINTAINERS
+-@@ -7,6 +7,7 @@ F:	configs/generic-rk3528_defconfig
+- NANOPI-ZERO2-RK3528
+- M:	Jonas Karlman <jonas@kwiboo.se>
+- S:	Maintained
+-+F:	arch/arm/dts/rk3528-nanopi-u-boot.dtsi
+- F:	arch/arm/dts/rk3528-nanopi-zero2*
+- F:	configs/nanopi-zero2-rk3528_defconfig
+- 
+diff --git a/package/boot/uboot-rockchip/patches/109-4-board-rockchip-Add-FriendlyElec-NanoPi-R28S.patch b/package/boot/uboot-rockchip/patches/109-4-board-rockchip-Add-FriendlyElec-NanoPi-R28S.patch
+deleted file mode 100644
+index 339028d2b684363a1d026ad32c6067bd40fda66b..0000000000000000000000000000000000000000
+--- a/package/boot/uboot-rockchip/patches/109-4-board-rockchip-Add-FriendlyElec-NanoPi-R28S.patch
++++ /dev/null
+@@ -1,140 +0,0 @@
+-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+-From: 安容 <HystericalDragons@proton.me>
+-Date: Mon, 12 Oct 2026 14:55:43 +0800
+-Subject: [PATCH] board: rockchip: Add FriendlyElec NanoPi R28S
+-MIME-Version: 1.0
+-Content-Type: text/plain; charset=UTF-8
+-Content-Transfer-Encoding: 8bit
+-
+-The FriendlyElec NanoPi R28S is a dual gigabit Ethernet router board
+-based on the Rockchip RK3528 SoC. It shares most of its design with the
+-NanoPi Zero2.
+-
+-Specifications:
+-- SoC: Rockchip RK3528, quad-core Cortex-A53 @ 2.0 GHz
+-- RAM: 1 GB LPDDR4
+-- Storage: microSD slot, optional onboard eMMC
+-- Ethernet: 1x GbE (GMAC1 + Realtek RTL8211F),
+-            1x GbE (Realtek RTL8111H over PCIe)
+-- WiFi: AICSemi AIC8800D80 over SDIO
+-- USB: 1x USB 2.0 Type-C (power input and OTG)
+-- UART: USB Type-C debug console (onboard WCH CH340E), 1500000 8N1
+-- Buttons: user (GPIO), MaskROM (SARADC)
+-
+-Add support for the board based on the NanoPi Zero2, and enable
+-CONFIG_BUTTON_GPIO for the user button.
+-
+-Features tested on NanoPi R28S:
+-- SD-card boot
+-- Ethernet
