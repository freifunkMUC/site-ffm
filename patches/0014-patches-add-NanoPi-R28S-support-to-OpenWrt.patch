+diff --git a/package/boot/uboot-rockchip/patches/002-04-v2027.04-rockchip-rk3528-Split-out-common-NanoPi-u-boot.dtsi.patch b/package/boot/uboot-rockchip/patches/002-04-v2027.04-rockchip-rk3528-Split-out-common-NanoPi-u-boot.dtsi.patch
