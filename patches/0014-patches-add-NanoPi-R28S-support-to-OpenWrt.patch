+diff --git a/target/linux/rockchip/patches-6.18/143-arm64-dts-rockchip-set-reset-button-for-NanoPi-R28S.patch b/target/linux/rockchip/patches-6.18/143-arm64-dts-rockchip-set-reset-button-for-NanoPi-R28S.patch
