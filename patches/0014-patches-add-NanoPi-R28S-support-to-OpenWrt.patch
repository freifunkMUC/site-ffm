+++	phys = <&usb2phy_otg>;
+++	phy-names = "usb2-phy";
+++	status = "okay";
+++};
+++
+++&usb2phy {
+++	status = "okay";
+++};
+++
+++&usb2phy_otg {
+++	status = "okay";
+++};
