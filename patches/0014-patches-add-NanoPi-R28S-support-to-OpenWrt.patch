++-			function = LED_FUNCTION_HEARTBEAT;
+++			function = LED_FUNCTION_POWER;
++ 			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
++-			linux,default-trigger = "heartbeat";
++ 		};
++ 
++ 		/* The purpose of the second LED differs per board. */
diff --git a/patches/openwrt/0006-uboot-rockchip-backport-NanoPi-R28S-support-from-U-Boot-next.patch b/patches/openwrt/0006-uboot-rockchip-backport-NanoPi-R28S-support-from-U-Boot-next.patch
