++ 		i2c1 = &i2c1;
+++		led-boot = &led_sys;
+++		led-failsafe = &led_sys;
+++		led-running = &led_sys;
+++		led-upgrade = &led_sys;
++ 		mmc0 = &sdhci;
++ 		mmc1 = &sdmmc;
++ 		serial0 = &uart0;
++@@ -37,12 +41,10 @@
++ 		pinctrl-names = "default";
++ 		pinctrl-0 = <&led_sys_pin>, <&led1_pin>;
++ 
