From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Annika Wickert <6527744+awlx@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:53:45 +0100
Subject: [PATCH] patches/openwrt: comgt-ncm: copy ip4table and ip6table to the
 dynamic interfaces

The ncm proto handler of OpenWrt 24.10 does not copy ip4table and
ip6table to cellular_4 and cellular_6. Their routes go into the main
table. On Parker, traffic with mark 1 (DNS of gluon-wan-dnsmasq, the
tunnel) then has no route on an ncm uplink.

Carry the ip4table and ip6table part of OpenWrt commit b289edd84b38
("comgt-ncm: fix setting ip[46]table and MTU").

Link: https://github.com/openwrt/openwrt/pull/20217
---
 ...d-ip6table-to-the-dynamic-interfaces.patch | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)
 create mode 100644 patches/openwrt/0031-comgt-ncm-copy-ip4table-and-ip6table-to-the-dynamic-interfaces.patch

diff --git a/patches/openwrt/0031-comgt-ncm-copy-ip4table-and-ip6table-to-the-dynamic-interfaces.patch b/patches/openwrt/0031-comgt-ncm-copy-ip4table-and-ip6table-to-the-dynamic-interfaces.patch
new file mode 100644
index 0000000..310f6e1
--- /dev/null
+++ b/patches/openwrt/0031-comgt-ncm-copy-ip4table-and-ip6table-to-the-dynamic-interfaces.patch
@@ -0,0 +1,65 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Annika Wickert <6527744+awlx@users.noreply.github.com>
+Date: Thu, 19 Nov 2026 12:53:19 +0100
+Subject: [PATCH 2/2] comgt-ncm: copy ip4table and ip6table to the dynamic
+ interfaces
+
+The ncm proto handler did not copy ip4table and ip6table of the
+parent interface to the dynamic interfaces <iface>_4 and <iface>_6.
+Their routes went into the main table.
+
+Copy the two options, as the qmi and mbim proto handlers do.
+
+This is the ip4table and ip6table part of commit b289edd84b38
+("comgt-ncm: fix setting ip[46]table and MTU") in main.
+
+Signed-off-by: Annika Wickert <6527744+awlx@users.noreply.github.com>
+---
+ package/network/utils/comgt/Makefile     | 2 +-
+ package/network/utils/comgt/files/ncm.sh | 6 ++++--
+ 2 files changed, 5 insertions(+), 3 deletions(-)
+
+diff --git a/package/network/utils/comgt/Makefile b/package/network/utils/comgt/Makefile
+index 0e826e1..036ea0f 100644
+--- a/package/network/utils/comgt/Makefile
++++ b/package/network/utils/comgt/Makefile
+@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=comgt
+ PKG_VERSION:=0.32
+-PKG_RELEASE:=36
++PKG_RELEASE:=37
+ 
+ PKG_SOURCE:=$(PKG_NAME).$(PKG_VERSION).tgz
+ PKG_SOURCE_URL:=@SF/comgt
+diff --git a/package/network/utils/comgt/files/ncm.sh b/package/network/utils/comgt/files/ncm.sh
+index e9412b2..b95f1e5 100644
+--- a/package/network/utils/comgt/files/ncm.sh
++++ b/package/network/utils/comgt/files/ncm.sh
+@@ -30,8 +30,8 @@ proto_ncm_setup() {
+ 
+ 	local manufacturer initialize setmode connect finalize devname devpath ifpath
+ 
+-	local device ifname  apn auth username password pincode delay mode pdptype profile $PROTO_DEFAULT_OPTIONS
+-	json_get_vars device ifname apn auth username password pincode delay mode pdptype sourcefilter delegate profile $PROTO_DEFAULT_OPTIONS
++	local device ifname  apn auth username password pincode delay mode pdptype profile ip4table ip6table $PROTO_DEFAULT_OPTIONS
++	json_get_vars device ifname apn auth username password pincode delay mode pdptype sourcefilter delegate profile ip4table ip6table $PROTO_DEFAULT_OPTIONS
+ 
+ 	local context_type
+ 
+@@ -194,6 +194,7 @@ proto_ncm_setup() {
+ 		[ -n "$zone" ] && {
+ 			json_add_string zone "$zone"
+ 		}
++		[ -n "$ip4table" ] && json_add_string ip4table "$ip4table"
+ 		json_close_object
+ 		ubus call network add_dynamic "$(json_dump)"
+ 	}
+@@ -210,6 +211,7 @@ proto_ncm_setup() {
+ 		[ -n "$zone" ] && {
+ 			json_add_string zone "$zone"
+ 		}
++		[ -n "$ip6table" ] && json_add_string ip6table "$ip6table"
+ 		json_close_object
+ 		ubus call network add_dynamic "$(json_dump)"
+ 	}
