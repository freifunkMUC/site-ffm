From 93778204a1aa9095012fe9d4bed442c65e53ed48 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Thu, 29 Oct 2026 17:03:32 +0100
Subject: [PATCH] openwrt: blacklist the TrustCor and Camerfirma CA roots

---
 ...st-the-TrustCor-and-Camerfirma-roots.patch | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 patches/openwrt/0100-ca-certificates-blacklist-the-TrustCor-and-Camerfirma-roots.patch

diff --git a/patches/openwrt/0100-ca-certificates-blacklist-the-TrustCor-and-Camerfirma-roots.patch b/patches/openwrt/0100-ca-certificates-blacklist-the-TrustCor-and-Camerfirma-roots.patch
new file mode 100644
index 00000000..43a2981b
--- /dev/null
+++ b/patches/openwrt/0100-ca-certificates-blacklist-the-TrustCor-and-Camerfirma-roots.patch
@@ -0,0 +1,57 @@
+From: Grische <github@grische.xyz>
+Date: Thu, 29 Oct 2026 17:03:32 +0100
+Subject: ca-certificates: blacklist the TrustCor and Camerfirma roots
+
+Mozilla distrusted the TrustCor and Camerfirma CAs and removed their
+roots from NSS (Mozilla bugs 1851049 and 1850982), but ca-certificates
+20200601 still trusts these five roots for TLS:
+
+  "Chambers of Commerce Root - 2008"
+  "Global Chambersign Root - 2008"
+  "TrustCor RootCert CA-1"
+  "TrustCor RootCert CA-2"
+  "TrustCor ECA-1"
+
+Blacklist them, which shrinks the bundle from 124 to 119 roots.
+
+diff --git a/package/system/ca-certificates/Makefile b/package/system/ca-certificates/Makefile
+index 4aaecf5ecf5facf0e65577eba1f27f69071f0cea..f10e18fce9c8b08583a9371296d29bcace22e062 100644
+--- a/package/system/ca-certificates/Makefile
++++ b/package/system/ca-certificates/Makefile
+@@ -8,7 +8,7 @@ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=ca-certificates
+ PKG_VERSION:=20200601
+-PKG_RELEASE:=2
++PKG_RELEASE:=3
+ PKG_MAINTAINER:=
+ 
+ PKG_SOURCE:=$(PKG_NAME)_$(PKG_VERSION).tar.xz
+diff --git a/package/system/ca-certificates/patches/0002-blacklist-TrustCor-and-Camerfirma-roots.patch b/package/system/ca-certificates/patches/0002-blacklist-TrustCor-and-Camerfirma-roots.patch
+new file mode 100644
+index 0000000000000000000000000000000000000000..8a1fd35213a6572ee4fcb5c47bdb810e70075f3b
+--- /dev/null
++++ b/package/system/ca-certificates/patches/0002-blacklist-TrustCor-and-Camerfirma-roots.patch
+@@ -0,0 +1,22 @@
++Blacklist the Camerfirma and TrustCor roots
++
++Mozilla distrusted both CAs and removed their roots from NSS, but
++ca-certificates 20200601 still trusts them for TLS.
++
++--- a/mozilla/blacklist.txt
+++++ b/mozilla/blacklist.txt
++@@ -42,3 +42,14 @@
++ "emSign ECC Root CA - G3"
++ # Blacklist "Comodo AAA Services root" (cf. #1151413)
++ "Comodo AAA Services root"
+++
+++# Blacklist the Camerfirma roots, distrusted and removed from NSS
+++# See: https://bugzilla.mozilla.org/show_bug.cgi?id=1850982
+++"Chambers of Commerce Root - 2008"
+++"Global Chambersign Root - 2008"
+++
+++# Blacklist the TrustCor roots, distrusted and removed from NSS
+++# See: https://bugzilla.mozilla.org/show_bug.cgi?id=1851049
+++"TrustCor RootCert CA-1"
+++"TrustCor RootCert CA-2"
+++"TrustCor ECA-1"
