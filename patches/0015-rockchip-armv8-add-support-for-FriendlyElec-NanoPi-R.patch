From 68c3677f401cd8cf9647ce231ab318e22d8cfeb0 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Thu, 19 Nov 2026 23:28:53 +0100
Subject: [PATCH 15/15] rockchip-armv8: add support for FriendlyElec NanoPi
 R28S

The WAN port gets its MAC address from U-Boot, which derives it from
the SoC cpuid. The RTL8111H of the LAN port has no programmed MAC
address, so OpenWrt sets the LAN MAC address to WAN + 1. As on the
other NanoPi boards, use the LAN MAC address as primary MAC address.

Sysupgrade only, no factory image.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Grische <github@grische.xyz>
---
 docs/user/supported_devices.rst                             | 1 +
 package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac | 1 +
 targets/rockchip-armv8                                      | 1 +
 3 files changed, 3 insertions(+)

diff --git a/docs/user/supported_devices.rst b/docs/user/supported_devices.rst
index 909d9fd4..d3b5e01f 100644
--- a/docs/user/supported_devices.rst
+++ b/docs/user/supported_devices.rst
@@ -662,6 +662,7 @@ rockchip-armv8
 
 * FriendlyElec
 
+  - NanoPi R28S
   - NanoPi R2S
   - NanoPi R2S Plus
   - NanoPi R3S
diff --git a/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac b/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
index bbb0ad18..5ed76e25 100755
--- a/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
+++ b/package/gluon-core/luasrc/lib/gluon/upgrade/010-primary-mac
@@ -109,6 +109,7 @@ local primary_addrs = {
 			'xiaomi,mi-router-4a-100m',
 		}},
 		{'rockchip', 'armv8', {
+			'friendlyarm,nanopi-r28s',
 			'friendlyarm,nanopi-r2s',
 			'friendlyarm,nanopi-r3s',
 			'friendlyarm,nanopi-r4s',
diff --git a/targets/rockchip-armv8 b/targets/rockchip-armv8
index 4e1a256d..20427e40 100644
--- a/targets/rockchip-armv8
+++ b/targets/rockchip-armv8
@@ -3,6 +3,7 @@ defaults {
 	sysupgrade_ext = '.img.gz',
 }
 
+device('friendlyelec-nanopi-r28s', 'friendlyarm_nanopi-r28s')
 device('friendlyelec-nanopi-r2s', 'friendlyarm_nanopi-r2s')
 device('friendlyelec-nanopi-r2s-plus', 'friendlyarm_nanopi-r2s-plus')
 device('friendlyelec-nanopi-r3s', 'friendlyarm_nanopi-r3s')
-- 
