 .../openwrt/0012-bump-libbpf-to-1.5.1.patch   | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)
 create mode 100644 patches/openwrt/0012-bump-libbpf-to-1.5.1.patch

diff --git a/patches/openwrt/0012-bump-libbpf-to-1.5.1.patch b/patches/openwrt/0012-bump-libbpf-to-1.5.1.patch
