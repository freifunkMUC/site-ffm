diff --git a/patches/openwrt/0027-mac80211-rtw88-make-a-secured-mesh-work-on-backports-7.2.patch b/patches/openwrt/0027-mac80211-rtw88-make-a-secured-mesh-work-on-backports-7.2.patch
new file mode 100644
index 00000000..6bb717c6
--- /dev/null
+++ b/patches/openwrt/0027-mac80211-rtw88-make-a-secured-mesh-work-on-backports-7.2.patch
@@ -0,0 +1,105 @@
+From: Grische <github@grische.xyz>
+Date: Fri, 13 Nov 2026 23:11:54 +0100
+Subject: mac80211: rtw88: make a secured mesh work on backports 7.2
+
+cfg80211 of backports 7.2 refuses the group key of a mesh peer unless
+the driver sets WIPHY_FLAG_IBSS_RSN, so a mesh with SAE on rtw88 peers
+but passes no traffic. Upstream dropped that requirement for mesh in
+7.3.
+
+Add a patch that sets the flag on the 8822C. The flag also allows RSN
+in an IBSS, where the group key of the interface would sit in the CAM
+and be applied to the group frames of the peers. The patch therefore
+leaves the group keys of an IBSS interface to software crypto, as
+ath9k and mt76 do. It is not meant for upstream and can be dropped
+once backports is at 7.3 or newer.
+
+Tested on the NanoPi R2S Plus against an ath10k peer. A mesh with SAE
+carries 48 Mbit/s towards the board and 27 Mbit/s from it, with all
+mesh keys in software. In an IBSS with WPA2 ARP resolves in both
+directions, while with the flag alone the ARP requests of the peer get
+no answer. AP and station mode perform as before. Joining an IBSS
+fails in some attempts, with and without this patch and also without
+encryption. The radio then sits on another channel than mac80211
+reports.
+
+Signed-off-by: Grische <github@grische.xyz>
+Assisted-by: Claude:claude-fable-5-2 Claude:claude-opus-5-5
+
+diff --git a/package/kernel/mac80211/Makefile b/package/kernel/mac80211/Makefile
+index eb01ab45df0a1be63fe44745c7b2b32d12406028..8fbe002df5b0887ee2f5677c71bdf6284f0dc77e 100644
+--- a/package/kernel/mac80211/Makefile
++++ b/package/kernel/mac80211/Makefile
+@@ -12,7 +12,7 @@ PKG_NAME:=mac80211
+ 
+ PKG_SOURCE_VERSION:=7.2
+ PKG_VERSION:=$(subst -,_,$(PKG_SOURCE_VERSION))
+-PKG_RELEASE:=16
++PKG_RELEASE:=17
+ PKG_LICENSE:=GPL-2.0-only
+ PKG_LICENSE_FILES:=COPYING
+ 
+diff --git a/package/kernel/mac80211/patches/rtl/010-wifi-rtw88-accept-the-group-keys-of-mesh-peers-before-7.3.patch b/package/kernel/mac80211/patches/rtl/010-wifi-rtw88-accept-the-group-keys-of-mesh-peers-before-7.3.patch
+new file mode 100644
+index 0000000000000000000000000000000000000000..a1ce2a1ffc6cd26ac3488be3a8b2816eda10f66b
+--- /dev/null
++++ b/package/kernel/mac80211/patches/rtl/010-wifi-rtw88-accept-the-group-keys-of-mesh-peers-before-7.3.patch
+@@ -0,0 +1,58 @@
++From: Grische <github@grische.xyz>
++Date: Fri, 13 Nov 2026 23:10:39 +0100
++Subject: [PATCH] wifi: rtw88: accept the group keys of mesh peers on cfg80211 before 7.3
++
++cfg80211 before commit 8ff047b9c7b2 ("wifi: cfg80211: clarify and
++tighten key checks") refuses a group key with a peer address unless the
++driver sets WIPHY_FLAG_IBSS_RSN. A secured mesh installs such a key for
++every peer. Without it the peering still completes, but the group
++frames of the peers cannot be decrypted, so no path is found and no
++traffic passes.
++
++Set the flag on the 8822C, where mesh point is advertised. The flag
++also lets an IBSS use RSN. The CAM finds group keys by their key index
++only, so the own group key of an IBSS interface would be applied to the
++group frames of every peer. Leave the TKIP and CCMP group keys of an
++IBSS interface to software crypto, as is done for mesh.
++
++This patch is for backports before 7.3 only and is not meant for
++upstream. With 8ff047b9c7b2 a mesh no longer needs the flag.
++
++Signed-off-by: Grische <github@grische.xyz>
++---
++ drivers/net/wireless/realtek/rtw88/mac80211.c | 10 ++++++++++
++ drivers/net/wireless/realtek/rtw88/main.c     |  4 ++++
++ 2 files changed, 14 insertions(+)
++
++--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
++@@ -621,6 +621,16 @@ static int rtw_ops_set_key(struct ieee80
++ 	if (vif->type == NL80211_IFTYPE_MESH_POINT)
++ 		return -EOPNOTSUPP;
++ 
+++	/* The flag also allows RSN in an IBSS. The CAM finds group keys
+++	 * by key index only, so leave the group keys of an IBSS interface
+++	 * to software crypto as well.
+++	 */
+++	if (vif->type == NL80211_IFTYPE_ADHOC &&
+++	    (key->cipher == WLAN_CIPHER_SUITE_TKIP ||
+++	     key->cipher == WLAN_CIPHER_SUITE_CCMP) &&
+++	    !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE))
+++		return -EOPNOTSUPP;
+++
++ 	switch (key->cipher) {
++ 	case WLAN_CIPHER_SUITE_WEP40:
++ 		hw_key_type = RTW_CAM_WEP40;
++--- a/drivers/net/wireless/realtek/rtw88/main.c
+++++ b/drivers/net/wireless/realtek/rtw88/main.c
++@@ -2306,6 +2306,10 @@ int rtw_register_hw(struct rtw_dev *rtwd
++ 		hw->wiphy->n_iface_combinations = ARRAY_SIZE(rtw_iface_combs);
++ 		/* Mesh point was tested on this chip only. */
++ 		hw->wiphy->interface_modes |= BIT(NL80211_IFTYPE_MESH_POINT);
+++		/* cfg80211 before 7.3 accepts the group keys of mesh peers
+++		 * only with this flag.
+++		 */
+++		hw->wiphy->flags |= WIPHY_FLAG_IBSS_RSN;
++ 	}
++ 
++ 	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_CAN_REPLACE_PTK0);
-- 
