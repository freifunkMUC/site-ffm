diff --git a/patches/openwrt/0021-rockchip-fix-IO-domain-supplies-of-NanoPi-R2S-Plus.patch b/patches/openwrt/0021-rockchip-fix-IO-domain-supplies-of-NanoPi-R2S-Plus.patch
