From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Annika Wickert <6527744+awlx@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:53:45 +0100
Subject: [PATCH] patches/openwrt: uqmi: report the DNS servers when peerdns is
 disabled

Gluon sets peerdns 0 on the cellular uplink. Then the qmi proto handler
does not add the DNS servers of the modem. netifd does not put them into
the inactive list, and gluon-wan-dnsmasq does not get them.

The IPv6 DNS servers of a qmi uplink are lost. They come on the parent
interface cellular, because the IPv6 bearer does not use dhcpv6.

Carry an OpenWrt patch that always adds the servers of the modem.
netifd decides with peerdns if it uses them.
---
 ...DNS-servers-when-peerdns-is-disabled.patch | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 patches/openwrt/0030-uqmi-report-the-DNS-servers-when-peerdns-is-disabled.patch

diff --git a/patches/openwrt/0030-uqmi-report-the-DNS-servers-when-peerdns-is-disabled.patch b/patches/openwrt/0030-uqmi-report-the-DNS-servers-when-peerdns-is-disabled.patch
new file mode 100644
index 0000000..34d9158
--- /dev/null
+++ b/patches/openwrt/0030-uqmi-report-the-DNS-servers-when-peerdns-is-disabled.patch
@@ -0,0 +1,63 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Annika Wickert <6527744+awlx@users.noreply.github.com>
+Date: Thu, 19 Nov 2026 12:53:19 +0100
+Subject: [PATCH 1/2] uqmi: report the DNS servers when peerdns is disabled
+
+With peerdns 0, qmi.sh does not add the DNS servers of the modem.
+netifd keeps the servers of an interface with peerdns 0 in the
+inactive list, so other programs can still read them. Gluon sets
+peerdns 0 on its cellular uplink and reads this list.
+
+The servers of the IPv6 bearer on the parent interface were lost.
+Always add the servers that the modem reports. netifd decides with
+peerdns if it uses them.
+
+Signed-off-by: Annika Wickert <6527744+awlx@users.noreply.github.com>
+---
+ package/network/utils/uqmi/Makefile                  |  2 +-
+ .../network/utils/uqmi/files/lib/netifd/proto/qmi.sh | 12 ++++--------
+ 2 files changed, 5 insertions(+), 9 deletions(-)
+
+diff --git a/package/network/utils/uqmi/Makefile b/package/network/utils/uqmi/Makefile
+index 46bc376..b1e58d5 100644
+--- a/package/network/utils/uqmi/Makefile
++++ b/package/network/utils/uqmi/Makefile
+@@ -1,7 +1,7 @@
+ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=uqmi
+-PKG_RELEASE:=2
++PKG_RELEASE:=3
+ 
+ PKG_SOURCE_PROTO:=git
+ PKG_SOURCE_URL=$(PROJECT_GIT)/project/uqmi.git
+diff --git a/package/network/utils/uqmi/files/lib/netifd/proto/qmi.sh b/package/network/utils/uqmi/files/lib/netifd/proto/qmi.sh
+index ebce281..e948e28 100644
+--- a/package/network/utils/uqmi/files/lib/netifd/proto/qmi.sh
++++ b/package/network/utils/uqmi/files/lib/netifd/proto/qmi.sh
+@@ -427,10 +427,8 @@ proto_qmi_setup() {
+ 			proto_add_ipv6_prefix "${ip_6}/${ip_prefix_length}"
+ 			proto_add_ipv6_route "$gateway_6" "128"
+ 			[ "$defaultroute" = 0 ] || proto_add_ipv6_route "::0" 0 "$gateway_6" "" "" "${ip_6}/${ip_prefix_length}"
+-			[ "$peerdns" = 0 ] || {
+-				proto_add_dns_server "$dns1_6"
+-				proto_add_dns_server "$dns2_6"
+-			}
++			[ -n "$dns1_6" ] && proto_add_dns_server "$dns1_6"
++			[ -n "$dns2_6" ] && proto_add_dns_server "$dns2_6"
+ 			[ -n "$zone" ] && {
+ 				proto_add_data
+ 				json_add_string zone "$zone"
+@@ -470,10 +468,8 @@ proto_qmi_setup() {
+ 			proto_add_ipv4_address "$ip_4" "$subnet_4"
+ 			proto_add_ipv4_route "$gateway_4" "128"
+ 			[ "$defaultroute" = 0 ] || proto_add_ipv4_route "0.0.0.0" 0 "$gateway_4"
+-			[ "$peerdns" = 0 ] || {
+-				proto_add_dns_server "$dns1_4"
+-				proto_add_dns_server "$dns2_4"
+-			}
++			[ -n "$dns1_4" ] && proto_add_dns_server "$dns1_4"
++			[ -n "$dns2_4" ] && proto_add_dns_server "$dns2_4"
+ 			[ -n "$zone" ] && {
+ 				proto_add_data
+ 				json_add_string zone "$zone"
