Subject: [PATCH 5/5] ci: seperately store metadata output

---
 .github/workflows/build-gluon.yml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/.github/workflows/build-gluon.yml b/.github/workflows/build-gluon.yml
index 8f3cc236..80af672c 100644
--- a/.github/workflows/build-gluon.yml
+++ b/.github/workflows/build-gluon.yml
@@ -66,3 +66,8 @@ jobs:
           name: ${{ matrix.target }}_output
           path: output
 
+      - name: Archive metadata
+        uses: actions/upload-artifact@v3
+        with:
+          name: ${{ matrix.target }}_metadata
+          path: output/meta
