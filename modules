# This file allows specifying additional repositories to use
# when building gluon.
#
# In most cases, it is not required so don't add it.

##	GLUON_SITE_FEEDS
#		for each feed name given, add the corresponding PACKAGES_* lines
#		documented below
GLUON_SITE_FEEDS='community'

PACKAGES_COMMUNITY_REPO=https://github.com/freifunk-gluon/community-packages.git
PACKAGES_COMMUNITY_COMMIT=ab534138c12fce622fe83d111bc3210cc4cfeab1
PACKAGES_COMMUNITY_BRANCH=main

##	OpenWrt base
#		The intel-mips target (AVM FRITZ!Box 7560, 7580 and 7590) needs
#		kernel 6.18 and is not part of OpenWrt yet. Gluon next pins OpenWrt
#		main, which lacks the target, so it cannot be built from Gluon's
#		own base.
#
#		scripts/modules.sh sources Gluon's modules file first and this one
#		second, so these assignments override Gluon's own pin. Gluon has
#		set OPENWRT_REPO and the others by then, which makes a
#		${OPENWRT_REPO:-...} default a silent no-op. The escape hatch
#		therefore uses names Gluon does not set itself.
OPENWRT_REPO=${SITE_OPENWRT_REPO:-https://github.com/grische/openwrt.git}
OPENWRT_BRANCH=${SITE_OPENWRT_BRANCH:-intel-mips-xrx500}
OPENWRT_COMMIT=${SITE_OPENWRT_COMMIT:-cffcf59a9a18b2db10d8bb84ab826cad4b147b00}
